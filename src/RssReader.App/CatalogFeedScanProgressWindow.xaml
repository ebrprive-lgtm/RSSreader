<Window x:Class="RssReader.App.CatalogFeedScanProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480"
        MinWidth="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">
    <Grid Margin="8">
        <Border Style="{StaticResource PopupOuterFrameStyle}">
            <Border Style="{StaticResource PopupInnerFrameStyle}" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="Check all visible feed sources"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Text="Preparing to check feed sources..."
                               Margin="0,10,0,12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <ProgressBar x:Name="ScanProgressBar"
                                 Height="7"
                                 Minimum="0"
                                 Maximum="1"
                                 IsIndeterminate="True" />
                    <TextBlock x:Name="ErrorText"
                               Visibility="Collapsed"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource DestructiveBrush}"
                               TextWrapping="Wrap" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            MinWidth="96"
                            Margin="0,18,0,0"
                            Padding="12,7"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            AutomationProperties.Name="Cancel feed scan"
                            Click="CancelButton_Click" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
