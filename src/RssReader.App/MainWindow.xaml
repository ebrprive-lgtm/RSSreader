<Window x:Class="RssReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RSS Reader"
        Width="1380"
        Height="860"
        MinWidth="760"
        MinHeight="540"
        Background="White"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <DataTemplate x:Key="SidebarLinkTemplate">
                <Button Style="{StaticResource SidebarButtonStyle}"
                    ToolTip="{Binding Label}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Count}"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ArticleRowTemplate">
            <Button Style="{StaticResource ArticleRowButtonStyle}"
                    Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Source}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding AgeLabel}"
                                       FontSize="12"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding PublishedDateLabel}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8EEEB" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentWashBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArticleRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F6F8F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarColumnWidth}" MinWidth="{Binding SidebarMinimumWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="14,14,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Button Command="{Binding ToggleSidebarCommand}"
                            Content="&#xE76B;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            ToolTip="Collapse or expand navigation"
                            HorizontalAlignment="Left"
                            Padding="9,8"
                            Background="Transparent"
                            BorderThickness="0" />
                    <Button Command="{Binding SwitchProfileCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,9"
                            HorizontalContentAlignment="Stretch"
                            ToolTip="Switch profile">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveProfileName}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PrimaryLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <Border Height="1" Background="#DDE3E0" Margin="8,12" />
                        <ItemsControl ItemsSource="{Binding ReadingLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <TextBlock Text="FEEDS"
                                   Margin="10,25,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding FeedLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <TextBlock Text="TAGS"
                                   Margin="10,23,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding TagLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <ItemsControl ItemsSource="{Binding AdminLinks}"
                                      ItemTemplate="{StaticResource SidebarLinkTemplate}"
                                      Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2"
                           Text="RSS READER"
                           Margin="9,12,0,2"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedTextBrush}"
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,26,42,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding WorkspaceTitle}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ActiveProfileName}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0"
                        Padding="11,7"
                        ToolTip="Refresh followed feeds" />
                <TextBox DockPanel.Dock="Right"
                         Width="290"
                         Height="38"
                         Padding="11,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Search your saved feed articles"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsSearchRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsArticleListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <CheckBox Content="Unread only"
                                      IsChecked="{Binding UnreadOnly, Mode=TwoWay}"
                                      Margin="0,0,14,0" />
                            <CheckBox Content="Saved only"
                                      IsChecked="{Binding SavedOnly, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VisibleArticles.Count, StringFormat={}{0} articles}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleArticles}" ItemTemplate="{StaticResource ArticleRowTemplate}" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsArticleListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="No articles in this view"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding IsReadingViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="&#xE72B;  Back to list"
                            FontFamily="Segoe UI, Segoe MDL2 Assets"
                            HorizontalAlignment="Left"
                            Padding="0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AccentBrush}"
                            Command="{Binding BackToListCommand}" />
                    <ScrollViewer Grid.Row="1" Margin="0,26,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedArticle.Source}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding SelectedArticle.PublishedDateLabel}"
                                       Margin="0,7,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding SelectedArticle.Title}"
                                       Margin="0,22,0,0"
                                       FontSize="31"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,26">
                                <CheckBox Content="Read later"
                                          IsChecked="{Binding SelectedArticle.IsSaved, Mode=TwoWay}"
                                          Margin="0,0,22,0" />
                                <CheckBox Content="Read"
                                          IsChecked="{Binding SelectedArticle.IsRead, Mode=TwoWay}" />
                            </StackPanel>
                            <Border Height="1" Background="#E3E9E6" />
                            <TextBlock Text="{Binding SelectedArticle.Summary}"
                                       Margin="0,25,0,0"
                                       FontSize="17"
                                       LineHeight="27"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedArticle.Content}"
                                       Margin="0,18,0,0"
                                       FontSize="15"
                                       LineHeight="24"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsCatalogBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Browse the feed catalog" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CatalogFeeds.Count, StringFormat={}{0} feeds}"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                         Width="150"
                                         Padding="8,6"
                                         ToolTip="New personal folder" />
                                <Button Content="Add folder"
                                        Command="{Binding AddFolderCommand}"
                                        Margin="6,0,0,0"
                                        Padding="9,6" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding CatalogFeeds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="250" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding CategoryName, TargetNullValue=Uncategorized}"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding FeedUrl}"
                                                           Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
                                                <Button Content="{Binding SubscriptionLabel}"
                                                        Command="{Binding DataContext.ToggleSubscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        MinWidth="82"
                                                        Padding="9,5" />
                                                <StackPanel Visibility="{Binding IsSubscribed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <DockPanel Margin="0,7,0,0">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="Set folder"
                                                                Command="{Binding DataContext.SaveFeedFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="5,0,0,0"
                                                                Padding="6,4" />
                                                        <ComboBox ItemsSource="{Binding DataContext.FolderNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding FolderName, Mode=TwoWay}"
                                                                  ToolTip="Personal folder"
                                                                  Padding="4" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <Button DockPanel.Dock="Right"
                                                                Content="Add tag"
                                                                Command="{Binding DataContext.AddFeedTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="5,0,0,0"
                                                                Padding="6,4" />
                                                        <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Padding="5,4"
                                                                 ToolTip="Personal tag" />
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Padding="5,2"
                                                                        Margin="0,0,4,3"
                                                                        Content="{Binding Name, StringFormat='{}{0}  x'}"
                                                                        ToolTip="Remove tag"
                                                                        Command="{Binding DataContext.RemoveFeedTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsCatalogAdminVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Catalog Master" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="Shared feed catalog" Margin="0,7,0,12" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding CatalogManagement.ErrorMessage}"
                                       Foreground="#A33C35"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,24,0">
                                <StackPanel>
                                    <TextBlock Text="Feeds" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding CatalogManagement.Feeds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,11">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding FeedUrl}"
                                                                       Margin="0,4,8,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CategoryName, TargetNullValue=Uncategorized}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource AccentBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="Remove"
                                                                Command="{Binding DataContext.CatalogManagement.DeleteFeedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center"
                                                                Padding="8,5" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Categories" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
                                    <ItemsControl ItemsSource="{Binding CatalogManagement.Categories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Remove"
                                                            Command="{Binding DataContext.CatalogManagement.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Collections" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,8" />
                                    <ItemsControl ItemsSource="{Binding CatalogManagement.Collections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Remove"
                                                            Command="{Binding DataContext.CatalogManagement.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Add feed" FontSize="15" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CatalogManagement.FeedName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,6"
                                             Padding="9,7"
                                             ToolTip="Feed name" />
                                    <TextBox Text="{Binding CatalogManagement.FeedUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6"
                                             Padding="9,7"
                                             ToolTip="Feed URL (HTTP or HTTPS)" />
                                    <TextBox Text="{Binding CatalogManagement.FeedDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6"
                                             Padding="9,7"
                                             ToolTip="Description (optional)" />
                                    <ComboBox ItemsSource="{Binding CatalogManagement.Categories}"
                                              SelectedItem="{Binding CatalogManagement.SelectedCategory}"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,0,8"
                                              Padding="7"
                                              ToolTip="Category (optional)" />
                                    <Button Content="Add feed" Command="{Binding CatalogManagement.AddFeedCommand}" Padding="10,7" />

                                    <TextBlock Text="Add category" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,4" />
                                    <TextBox Text="{Binding CatalogManagement.CategoryName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,6,0,6"
                                             Padding="9,7" />
                                    <Button Content="Add category" Command="{Binding CatalogManagement.AddCategoryCommand}" Padding="10,7" />

                                    <TextBlock Text="Add collection" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,4" />
                                    <TextBox Text="{Binding CatalogManagement.CollectionName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,6,0,6"
                                             Padding="9,7" />
                                    <Button Content="Add collection" Command="{Binding CatalogManagement.AddCollectionCommand}" Padding="10,7" />

                                    <TextBlock Text="Collection feeds" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,4" />
                                    <ComboBox ItemsSource="{Binding CatalogManagement.Feeds}"
                                              SelectedItem="{Binding CatalogManagement.SelectedFeed}"
                                              DisplayMemberPath="Name"
                                              Margin="0,6,0,6"
                                              Padding="7" />
                                    <ComboBox ItemsSource="{Binding CatalogManagement.Collections}"
                                              SelectedItem="{Binding CatalogManagement.SelectedCollection}"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,0,6"
                                              Padding="7" />
                                    <Button Content="Add feed to collection"
                                            Command="{Binding CatalogManagement.AddFeedToCollectionCommand}"
                                            Padding="10,7" />
                                    <Button Content="Remove feed from collection"
                                            Command="{Binding CatalogManagement.RemoveFeedFromCollectionCommand}"
                                            Margin="0,6,0,0"
                                            Padding="10,7" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsGoToRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="560">
                        <TextBlock Text="Go to" FontSize="21" FontWeight="SemiBold" />
                        <TextBox Text="{Binding QuickQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,14,0,12"
                                 Padding="11,9"
                                 Height="40"
                                 VerticalContentAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding QuickTargets}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
