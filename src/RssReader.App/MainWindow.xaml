<Window x:Class="RssReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RssReader.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    x:Name="MainWindowRoot"
        Title="RSS Reader"
        WindowStyle="None"
        Width="1380"
        Height="860"
        MinWidth="760"
        MinHeight="540"
        Background="White"
        Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:OptionalUriConverter x:Key="OptionalUriConverter" />
        <Style x:Key="ArticleRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NeutralHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReadLaterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Content" Value="&#xE734;" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource NeutralHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArticleFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FilterBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="{StaticResource NeutralHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="{StaticResource AccentWashBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VirtualizedArticleListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="local:SmoothScrollBehavior.IsEnabled" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="ArticleCardsPanel">
            <vwp:VirtualizingWrapPanel Orientation="Horizontal" ItemSize="322,326" SpacingMode="None" />
        </ItemsPanelTemplate>
        <Style x:Key="ArticleCardsListStyle" TargetType="ListBox" BasedOn="{StaticResource VirtualizedArticleListStyle}">
            <Setter Property="ItemsPanel" Value="{StaticResource ArticleCardsPanel}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="322" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Focusable" Value="False" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DateArticleCardsListStyle" TargetType="ListBox" BasedOn="{StaticResource ArticleCardsListStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsCardsView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSortByDate, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FolderArticleCardsListStyle" TargetType="ListBox" BasedOn="{StaticResource ArticleCardsListStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.IsCardsView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSortByDate, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NeutralHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentWashBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="True" />
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Padding" Value="9,8,40,8" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="True" />
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Padding" Value="9,8,40,8" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarLinkRootStyle" TargetType="Grid">
            <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFeedEntry}" Value="True">
                    <Setter Property="Height" Value="0" />
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFeedEntry}" Value="True" />
                        <Condition Binding="{Binding ParentFolder.IsExpanded}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Setter Property="IsEnabled" Value="True" />
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Height" From="0" To="34" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SidebarLinkTemplate">
            <Grid x:Name="SidebarLinkRoot"
                Style="{StaticResource SidebarLinkRootStyle}"
                MouseEnter="SidebarLinkRoot_MouseEnter"
                MouseLeave="SidebarLinkRoot_MouseLeave">
                <Button Style="{StaticResource SidebarButtonStyle}"
                       Command="{Binding DataContext.ActivateSidebarLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                       CommandParameter="{Binding}">
                    <Grid Margin="{Binding IndentMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="9"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE76C;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="&#xE70D;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFeedEntry}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Count}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Button>
                <Button Width="28"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Content="&#xE74D;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="Delete folder"
                        ToolTip="Delete folder">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DeleteButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DeleteButtonBorder" Property="Background" Value="{StaticResource DestructiveWashBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource DestructiveBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="DeleteButtonBorder" Property="Background" Value="#F3D1CE" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="IsHitTestVisible" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ArticleRowTemplate">
            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                <Grid MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ReadLaterToggle"
                                  IsChecked="{Binding IsSaved, Mode=TwoWay}"
                                  Style="{StaticResource ReadLaterToggleStyle}"
                                  AutomationProperties.Name="{Binding ReadLaterAutomationName}"
                                  ToolTip="Click to add to read later" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ArticleRowButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source}"
                                       ToolTip="{Binding Source}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Folder}"
                                       ToolTip="{Binding Folder}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DataContext.IsSortByDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                <Run Text="  " />
                                <Run Text="{Binding Summary, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            </TextBlock>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding AgeLabel}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter TargetName="ReadLaterToggle" Property="ToolTip" Value="Remove from read later" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ArticleMagazineTemplate">
            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                <Grid MinHeight="106">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="MagazineReadLaterToggle"
                                  IsChecked="{Binding IsSaved, Mode=TwoWay}"
                                  Style="{StaticResource ReadLaterToggleStyle}"
                                  AutomationProperties.Name="{Binding ReadLaterAutomationName}"
                                  ToolTip="Click to add to read later" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ArticleRowButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="154" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Height="96" Background="{StaticResource NeutralHoverBrush}" VerticalAlignment="Top">
                                <Border x:Name="MagazineImageFallback" Background="{StaticResource NeutralHoverBrush}">
                                    <TextBlock Text="&#xE91B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="24"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Image x:Name="MagazineArticleImage"
                                       Source="{Binding ImageUrl, TargetNullValue={x:Null}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="{Binding Title}"
                                           MaxHeight="42"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Source}"
                                               ToolTip="{Binding Source}"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="  •  " FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AgeLabel}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Folder}"
                                               Margin="10,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding DataContext.IsSortByDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}"
                                           Height="54"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter TargetName="MagazineReadLaterToggle" Property="ToolTip" Value="Remove from read later" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                    <Setter TargetName="MagazineArticleImage" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ArticleCardTemplate">
            <Button Style="{StaticResource ArticleRowButtonStyle}"
                    Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Border Width="310"
                        Height="314"
                        Margin="0,0,12,12"
                        Background="White"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <Grid Height="166" Background="{StaticResource NeutralHoverBrush}">
                            <Border x:Name="ImageFallback" Background="{StaticResource NeutralHoverBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="62"
                                            Height="62"
                                            CornerRadius="31"
                                            Background="#D6E2DB"
                                            BorderBrush="#BCCDC3"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding SourceInitials}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="#4D685A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border Margin="0,9,0,0"
                                            Padding="9,3"
                                            Background="#F6F9F7"
                                            BorderBrush="#CDDAD2"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <TextBlock Text="{Binding Folder}"
                                                   MaxWidth="180"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#53695C"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Image x:Name="ArticleImage"
                                Source="{Binding ImageUrl, TargetNullValue={x:Null}}"
                                   Stretch="UniformToFill" />
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="10"
                                    Padding="8,4"
                                    Background="#B0000000"
                                    CornerRadius="3">
                                <TextBlock Text="{Binding Source}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="240" />
                            </Border>
                        </Grid>
                        <StackPanel Margin="13,11,13,10">
                            <TextBlock Text="{Binding Title}"
                                       Height="46"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}"
                                       Height="48"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AgeLabel}"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                    <Setter TargetName="ArticleImage" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SidebarIconTemplate">
            <Border Width="18"
                    Height="14"
                    BorderBrush="{StaticResource MutedTextBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentWashBrush}" />
                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource MutedTextBrush}"
                            BorderThickness="1,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="{StaticResource NeutralHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArticleViewModeStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource AccentWashBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource NeutralHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPanel"
            Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="{Binding SidebarColumnSpan}"
                Width="{Binding SidebarPanelWidth}"
                HorizontalAlignment="Left"
                Panel.ZIndex="10"
                Background="{StaticResource SidebarBrush}"
                Padding="14,14,12,12"
                MouseEnter="SidebarPanel_MouseEnter"
                MouseLeave="SidebarPanel_MouseLeave">
            <Border.RenderTransform>
                <TranslateTransform X="-286" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="{Binding SidebarHeaderMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ProfileMenuButton"
                            Click="ProfileMenuButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,9"
                            HorizontalContentAlignment="Stretch"
                            ToolTip="Profile options">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ProfileContextMenu"
                                         Background="White"
                                         BorderBrush="{StaticResource ControlBorderBrush}"
                                         BorderThickness="1"
                                         Padding="5">
                                <MenuItem Header="Preferences" Click="PreferencesMenuItem_Click" Padding="12,8" />
                                <Separator />
                                <MenuItem Header="Log Out" Click="LogoutMenuItem_Click" Padding="12,8" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveProfileName}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="SidebarPinButton"
                            Grid.Column="1"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            ContentTemplate="{StaticResource SidebarIconTemplate}"
                            ToolTip="Hide sidebar"
                            AutomationProperties.Name="Hide sidebar" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PrimaryLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="8,12" />
                        <ItemsControl ItemsSource="{Binding ReadingLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <TextBlock Text="FEEDS"
                                   Margin="10,25,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding FeedLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <TextBlock Text="TAGS"
                                   Margin="10,23,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding TagLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <ItemsControl ItemsSource="{Binding AdminLinks}"
                                      ItemTemplate="{StaticResource SidebarLinkTemplate}"
                                      Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2"
                           Text="RSS READER"
                           Margin="9,12,0,2"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedTextBrush}"
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="38,0,42,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel x:Name="WorkspaceHeader" LastChildFill="False" Margin="0,0,0,22">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReadingViewVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding WorkspaceTitle}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VisibleArticles.Count, StringFormat={}{0} articles}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding IsArticleCountVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0"
                        MinWidth="112"
                        Height="38"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="Refresh followed feeds"
                        AutomationProperties.Name="Refresh followed feeds">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBox DockPanel.Dock="Right"
                         Width="290"
                         Height="38"
                         Padding="11,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Search your saved feed articles"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsSearchRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsArticleListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Content="&#xE8D4;"
                                          FontFamily="Segoe MDL2 Assets"
                                          IsChecked="{Binding UnreadOnly, Mode=TwoWay}"
                                          Style="{StaticResource ArticleFilterToggleStyle}"
                                          ToolTip="Show unread articles only"
                                          AutomationProperties.Name="Unread only"
                                          Margin="0,0,6,0" />
                            <ToggleButton Content="&#xE734;"
                                          FontFamily="Segoe MDL2 Assets"
                                          IsChecked="{Binding SavedOnly, Mode=TwoWay}"
                                          Style="{StaticResource ArticleFilterToggleStyle}"
                                          ToolTip="Show saved articles only"
                                          AutomationProperties.Name="Saved only"
                                          Margin="0,0,10,0" />
                            <Border BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Cards"
                                                 GroupName="ArticleViewMode"
                                                 IsChecked="{Binding IsCardsView, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                    <RadioButton Content="Title-Only"
                                                 GroupName="ArticleViewMode"
                                                 IsChecked="{Binding IsListView, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                    <RadioButton Content="Magazine"
                                                 GroupName="ArticleViewMode"
                                                 IsChecked="{Binding IsMagazineView, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="8,0,0,0"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="2"
                                    Visibility="{Binding IsArticleListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Sort by date"
                                                 GroupName="ArticleSortMode"
                                                 IsChecked="{Binding IsSortByDate, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                    <RadioButton Content="Sort by Folder"
                                                 GroupName="ArticleSortMode"
                                                 IsChecked="{Binding IsSortByFolder, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="ArticleRowsList"
                             Grid.Row="1"
                             Style="{StaticResource VirtualizedArticleListStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemsSource="{Binding ArticleListView}"
                             ItemTemplate="{StaticResource ArticleRowTemplate}"
                             Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                    </ListBox>
                    <ListBox x:Name="ArticleMagazineList"
                             Grid.Row="1"
                             Style="{StaticResource VirtualizedArticleListStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemsSource="{Binding ArticleListView}"
                             ItemTemplate="{StaticResource ArticleMagazineTemplate}"
                             Visibility="{Binding IsMagazineView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                    </ListBox>
                    <ListBox x:Name="ArticleCardsList"
                             Grid.Row="1"
                             Style="{StaticResource DateArticleCardsListStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding DateSortedArticleListView}"
                             ItemTemplate="{StaticResource ArticleCardTemplate}">
                    </ListBox>
                    <ListBox x:Name="ArticleFolderCardsList"
                             Grid.Row="1"
                             Style="{StaticResource FolderArticleCardsListStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding FolderSortedArticleListView}"
                             ItemTemplate="{StaticResource ArticleCardTemplate}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                    </ListBox>
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsArticleListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="No articles in this view"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding IsReadingViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="&#xE72B;  Back to list"
                                FontFamily="Segoe UI, Segoe MDL2 Assets"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="0,0,18,0"
                                Padding="0,4"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource AccentBrush}"
                                Command="{Binding BackToListCommand}" />
                        <TextBlock x:Name="SelectedArticleTitle"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="Open article source">
                            <Hyperlink NavigateUri="{Binding SelectedArticle.Link}"
                                       RequestNavigate="SourceLink_RequestNavigate"
                                       Foreground="{StaticResource TextBrush}"
                                       TextDecorations="{x:Null}"
                                       Cursor="Hand">
                                <Run Text="{Binding SelectedArticle.Title, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                        <Button Grid.Column="2"
                                Content="Show RAW"
                                Click="ShowRawFeed_Click"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                                Margin="18,0,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsRawFeedButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <local:ArticleHtmlViewer x:Name="SelectedArticleHtmlViewer"
                                             Grid.Row="1"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                </Grid>

                <Grid Visibility="{Binding IsCatalogBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Browse the feed catalog" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CatalogResultsSummary}"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <ProgressBar x:Name="CatalogLoadProgressBar"
                                             Height="3"
                                             Margin="0,7,0,0"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsCatalogLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock Text="Search feeds"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                                <TextBox MinHeight="34"
                                         Padding="9,5"
                                         VerticalContentAlignment="Center"
                                         x:Name="CatalogFeedSearchBox"
                                         AutomationProperties.Name="Search feeds"
                                         ToolTip="Search names, descriptions, categories, or feed URLs"
                                         Text="{Binding CatalogSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                                <ComboBox Width="190"
                                          Height="32"
                                          Margin="0,0,12,0"
                                          x:Name="CatalogCategoryFilter"
                                          AutomationProperties.Name="Filter by category"
                                          ToolTip="Filter catalog feeds by category"
                                          ItemsSource="{Binding CatalogCategoryOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedCatalogCategory}" />
                                <ComboBox Width="190"
                                          Height="32"
                                          Margin="0,0,12,0"
                                          x:Name="CatalogCollectionFilter"
                                          AutomationProperties.Name="Filter by collection"
                                          ToolTip="Browse curated collections"
                                          ItemsSource="{Binding CatalogCollectionOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedCatalogCollection}" />
                                <CheckBox x:Name="HideFollowedCatalogCheckBox"
                                          Content="Hide followed"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding HideFollowedCatalogFeeds}" />
                                <Button x:Name="ClearSelectedCatalogFeedsButton"
                                    Content="Clear selection"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Padding="10,5"
                                    IsEnabled="{Binding HasSelectedCatalogFeeds}"
                                    Command="{Binding ClearSelectedCatalogFeedsCommand}" />
                                <Button Content="Clear filters"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                        Padding="10,5"
                                        Command="{Binding ClearCatalogFiltersCommand}" />
                            </WrapPanel>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding SelectedCatalogCollectionCuratorLabel}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="23" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SelectAllCatalogFeedsCheckBox"
                                      Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      IsThreeState="True"
                                      IsChecked="{Binding VisibleCatalogFeedSelectionState, Mode=OneWay}"
                                      IsEnabled="{Binding CanSelectVisibleCatalogFeeds}"
                                      Command="{Binding ToggleVisibleCatalogFeedSelectionCommand}"
                                      AutomationProperties.Name="Select all visible feeds"
                                      ToolTip="Select all eligible feeds shown, or clear the selection" />
                            <Button x:Name="BatchFollowSelectedButton"
                                    Grid.Column="1"
                                    Content="&#xE710;"
                                    Style="{StaticResource IconActionButtonStyle}"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="15"
                                    Width="34"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    IsEnabled="{Binding CanFollowSelectedCatalogFeeds}"
                                    Command="{Binding FollowSelectedCatalogFeedsCommand}"
                                    AutomationProperties.Name="Follow selected feeds"
                                    AutomationProperties.HelpText="{Binding FollowSelectedCatalogFeedsLabel}"
                                    ToolTip="{Binding FollowSelectedCatalogFeedsLabel}" />
                            <Button x:Name="UnfollowAllCatalogFeedsButton"
                                    Grid.Column="2"
                                    Content="&#xE738;"
                                    Style="{StaticResource IconActionButtonStyle}"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="15"
                                    Width="34"
                                    Height="32"
                                    IsEnabled="{Binding CanUnfollowAllCatalogFeeds}"
                                    Command="{Binding UnfollowAllCatalogFeedsCommand}"
                                    AutomationProperties.Name="Unfollow all feeds"
                                    ToolTip="Unfollow followed feeds visible in this list" />
                        </Grid>
                        <Grid Grid.Row="3">
                            <ListBox ItemsSource="{Binding CatalogFeedListView}"
                                     x:Name="CatalogFeedResultsList"
                                     AutomationProperties.Name="Catalog feed results"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"
                                                          IsChecked="{Binding IsSelectedForFollow}"
                                                          IsEnabled="{Binding CanSelectForFollow}"
                                                          Visibility="{Binding CanSelectForFollow, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          AutomationProperties.Name="{Binding SelectForFollowAutomationName}"
                                                          AutomationProperties.HelpText="Select this feed to follow it with one folder choice"
                                                          ToolTip="Select for batch follow" />
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding CategoryName, TargetNullValue=Uncategorized}"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Description}"
                                                               Margin="0,1,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               AutomationProperties.Name="Catalog feed description"
                                                               ToolTip="{Binding Description}"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Grid Margin="0,1,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding FeedUrl}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FeedUrl}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding PublisherWebsiteDisplay}"
                                                                   Margin="8,0,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding WebsiteUrl}" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Width="32"
                                                            Height="32"
                                                            Style="{StaticResource IconActionButtonStyle}"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="PreviewCatalogFeed_Click"
                                                            IsEnabled="{Binding DataContext.IsCatalogFeedPreviewAvailable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            AutomationProperties.Name="{Binding PreviewAutomationName}"
                                                            ToolTip="Preview recent entries without following this feed">
                                                        <TextBlock Text="&#xE890;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="16"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Button>
                                                    <Button Width="32"
                                                            Height="32"
                                                            Margin="4,0,0,0"
                                                            Style="{StaticResource IconActionButtonStyle}"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.ToggleSubscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{Binding SubscriptionAutomationName}"
                                                            ToolTip="{Binding SubscriptionLabel}">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="16">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE710;" />
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSubscribed}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE738;" />
                                                                            <Setter Property="Foreground" Value="{StaticResource DestructiveBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding CatalogResultsEmptyMessage}"
                                       Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding IsCatalogResultsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <Border Grid.Row="2"
                                Panel.ZIndex="1"
                                Margin="12"
                                Padding="16"
                                Background="White"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Top"
                                Visibility="{Binding HasCatalogLoadError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding CatalogLoadErrorMessage}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <Button Content="Retry catalog load"
                                        AutomationProperties.Name="Retry loading the feed catalog"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding RetryCatalogLoadCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Padding="10,6" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsCatalogAdminVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                            <Button x:Name="CatalogActionsButton"
                                    DockPanel.Dock="Right"
                                    Content="..."
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    MinWidth="38"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    ToolTip="Catalog actions"
                                    AutomationProperties.Name="Catalog actions"
                                    Click="CatalogActionsButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Import OPML..." Click="ImportOpml_Click" />
                                        <MenuItem Header="Load starter pack"
                                                  Command="{Binding PlacementTarget.DataContext.CatalogManagement.LoadStarterPackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button DockPanel.Dock="Right"
                                    Content="Add feed"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Click="AddFeed_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Catalog Master" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Shared feed catalog" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                <ProgressBar x:Name="CatalogManagementLoadProgressBar"
                                             Height="2"
                                             Margin="0,6,0,0"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsCatalogLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,6"
                                       Visibility="{Binding HasCatalogLoadError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button DockPanel.Dock="Right"
                                        Content="Retry"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding RetryCatalogLoadCommand}"
                                        Padding="9,5" />
                                <TextBlock Text="{Binding CatalogLoadErrorMessage}"
                                           Foreground="{StaticResource DestructiveBrush}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding CatalogManagement.ErrorMessage}"
                                       Foreground="{StaticResource DestructiveBrush}"
                                       Margin="0,0,0,6"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CatalogManagement.ImportMessage}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TabControl x:Name="CatalogManagementTabs" Grid.Row="2" DataContext="{Binding}">
                            <TabItem Header="Feeds" DataContext="{Binding DataContext, ElementName=MainWindowRoot}">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="CatalogManagementSearchBox"
                                             Grid.Row="0"
                                             MinHeight="34"
                                             Padding="9,5"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Search catalog feeds"
                                             ToolTip="Search feed names, descriptions, categories, feed URLs, and publisher websites"
                                             Text="{Binding CatalogManagement.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                    <WrapPanel Grid.Row="1" Margin="0,8,0,6" VerticalAlignment="Center">
                                        <ComboBox x:Name="CatalogManagementCategoryFilter"
                                                  Width="190"
                                                  Height="32"
                                                  Margin="0,0,8,4"
                                                  AutomationProperties.Name="Filter catalog feeds by category"
                                                  ItemsSource="{Binding CatalogManagement.CategoryFilterOptions}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding CatalogManagement.SelectedCategoryFilter}" />
                                        <ComboBox x:Name="CatalogManagementCollectionFilter"
                                                  Width="190"
                                                  Height="32"
                                                  Margin="0,0,8,4"
                                                  AutomationProperties.Name="Filter catalog feeds by collection"
                                                  ItemsSource="{Binding CatalogManagement.CollectionFilterOptions}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding CatalogManagement.SelectedCollectionFilter}" />
                                        <ComboBox x:Name="CatalogManagementHealthFilter"
                                                  Width="170"
                                                  Height="32"
                                                  Margin="0,0,8,4"
                                                  AutomationProperties.Name="Filter catalog feeds by health check"
                                                  ItemsSource="{Binding CatalogManagement.HealthFilterOptions}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding CatalogManagement.SelectedHealthFilter}" />
                                        <CheckBox Content="Metadata gaps only"
                                                  Margin="0,0,12,4"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding CatalogManagement.ShowMetadataGapsOnly}" />
                                        <Button Content="Clear filters"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                                Margin="0,0,0,4"
                                                Padding="9,5"
                                                Command="{Binding CatalogManagement.ClearFiltersCommand}" />
                                    </WrapPanel>
                                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding CatalogManagement.FeedResultsSummary}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding CatalogManagement.MetadataReviewSummary}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </DockPanel>
                                    <Grid Grid.Row="3">
                                        <ListBox x:Name="CatalogManagementFeedList"
                                                 ItemsSource="{Binding DataContext.CatalogManagement.VisibleFeeds, ElementName=MainWindowRoot}"
                                                 AutomationProperties.Name="Catalog feed management results"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#B8C5BE" BorderThickness="0,0,0,1" Padding="0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock DockPanel.Dock="Right"
                                                                               Text="{Binding CategoryName, TargetNullValue=Uncategorized}"
                                                                               Margin="8,0,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding SameNameDisplay}"
                                                                                   Margin="0,0,8,0"
                                                                                   FontSize="10"
                                                                                   Foreground="{StaticResource WarningBrush}"
                                                                                   Visibility="{Binding HasSameName, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <TextBlock Text="&#xE7BA;"
                                                                                   Margin="0,0,8,0"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="13"
                                                                                   Foreground="{StaticResource WarningBrush}"
                                                                                   ToolTip="{Binding MetadataReviewDisplay}"
                                                                                   AutomationProperties.Name="{Binding MetadataReviewDisplay}"
                                                                                   Visibility="{Binding HasMetadataGaps, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="14"
                                                                                   ToolTip="{Binding HealthCheckDisplay}"
                                                                                   AutomationProperties.Name="{Binding HealthCheckDisplay}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasHealthCheck}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding LastHealthCheckSucceeded}" Value="False">
                                                                                            <Setter Property="Text" Value="&#xE711;" />
                                                                                            <Setter Property="Foreground" Value="{StaticResource DestructiveBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="14"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Name}" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="0,1,8,0"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Description}"
                                                                           AutomationProperties.Name="Catalog feed description"
                                                                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <Grid Margin="0,1,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontSize="10"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding FeedUrl}">
                                                                        <Hyperlink NavigateUri="{Binding FeedUrl, Mode=OneWay, Converter={StaticResource OptionalUriConverter}}"
                                                                                   RequestNavigate="SourceLink_RequestNavigate"
                                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                                   TextDecorations="None">
                                                                            <Run Text="{Binding FeedUrl, Mode=OneWay}" />
                                                                        </Hyperlink>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="1"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               TextAlignment="Right"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding WebsiteUrl}">
                                                                        <Hyperlink NavigateUri="{Binding WebsiteUrl, Mode=OneWay, Converter={StaticResource OptionalUriConverter}}"
                                                                                   RequestNavigate="SourceLink_RequestNavigate"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   TextDecorations="None">
                                                                            <Run Text="{Binding PublisherWebsiteDisplay, Mode=OneWay}" />
                                                                        </Hyperlink>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Click="PreviewManagedFeed_Click"
                                                                        Width="32"
                                                                        Height="32"
                                                                    Style="{StaticResource IconActionButtonStyle}"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Preview feed"
                                                                        AutomationProperties.Name="Preview feed">
                                                                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2673B8" />
                                                                </Button>
                                                                <Button Click="EditFeed_Click"
                                                                        Width="32"
                                                                        Height="32"
                                                                    Style="{StaticResource IconActionButtonStyle}"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Edit feed"
                                                                        AutomationProperties.Name="Edit feed">
                                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#2673B8" />
                                                                </Button>
                                                                <Button Command="{Binding DataContext.CatalogManagement.CheckFeedHealthCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="32"
                                                                        Height="32"
                                                                    Style="{StaticResource IconActionButtonStyle}"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Check feed"
                                                                        AutomationProperties.Name="Check feed">
                                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SuccessBrush}" />
                                                                </Button>
                                                                <Button Command="{Binding DataContext.CatalogManagement.DeleteFeedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="32"
                                                                        Height="32"
                                                                    Style="{StaticResource DestructiveIconActionButtonStyle}"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Remove feed"
                                                                        AutomationProperties.Name="Remove feed">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource DestructiveBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{Binding CatalogManagement.FeedResultsEmptyMessage}"
                                                   Margin="12,16,12,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   IsHitTestVisible="False"
                                                   Panel.ZIndex="1"
                                                   Visibility="{Binding CatalogManagement.IsFeedResultsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Categories &amp; collections" DataContext="{Binding DataContext, ElementName=MainWindowRoot}">
                                <Grid Margin="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,16,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="+"
                                                    Width="30"
                                                    Height="30"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    FontSize="19"
                                                    Padding="0"
                                                    ToolTip="Add category"
                                                    AutomationProperties.Name="Add category"
                                                    Click="AddCategory_Click" />
                                            <TextBlock Text="Categories" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding CatalogManagement.Categories}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DataTemplate.Resources>
                                                            <Style x:Key="TaxonomyHoverActionStyle" TargetType="Button">
                                                                <Setter Property="Width" Value="30" />
                                                                <Setter Property="Height" Value="30" />
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Margin" Value="0,0,2,0" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Opacity" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataTemplate.Resources>
                                                        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Button Style="{StaticResource TaxonomyHoverActionStyle}"
                                                                            Click="RenameCategory_Click"
                                                                            ToolTip="Rename category"
                                                                            AutomationProperties.Name="Rename category">
                                                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#2673B8" />
                                                                    </Button>
                                                                    <Button Style="{StaticResource TaxonomyHoverActionStyle}"
                                                                            Command="{Binding DataContext.CatalogManagement.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Remove category"
                                                                            AutomationProperties.Name="Remove category">
                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource DestructiveBrush}" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="16,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button Content="+"
                                                    Width="30"
                                                    Height="30"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    FontSize="19"
                                                    Padding="0"
                                                    ToolTip="Add collection"
                                                    AutomationProperties.Name="Add collection"
                                                    Click="AddCollection_Click" />
                                            <TextBlock Text="Collections" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1"
                                                   Text="Curated by Catalog Master"
                                                   Margin="0,0,0,8"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding CatalogManagement.Collections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DataTemplate.Resources>
                                                            <Style x:Key="TaxonomyHoverActionStyle" TargetType="Button">
                                                                <Setter Property="Width" Value="30" />
                                                                <Setter Property="Height" Value="30" />
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Margin" Value="0,0,2,0" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Opacity" Value="0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </DataTemplate.Resources>
                                                        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1"
                                                                        Style="{StaticResource TaxonomyHoverActionStyle}"
                                                                        Command="{Binding DataContext.CatalogManagement.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Remove collection"
                                                                        AutomationProperties.Name="Remove collection">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource DestructiveBrush}" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsGoToRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="560">
                        <TextBlock Text="Go to" FontSize="21" FontWeight="SemiBold" />
                        <TextBox Text="{Binding QuickQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,14,0,12"
                                 Padding="11,9"
                                 Height="40"
                                 VerticalContentAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding QuickTargets}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Button x:Name="SidebarPeekButton"
            Grid.Row="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8,8,0,0"
                Command="{Binding ToggleSidebarCommand}"
                Style="{StaticResource SidebarIconButtonStyle}"
                ContentTemplate="{StaticResource SidebarIconTemplate}"
                ToolTip="Show sidebar"
                AutomationProperties.Name="Pin sidebar"
                Visibility="Collapsed"
                Panel.ZIndex="20"
                MouseEnter="SidebarPeekButton_MouseEnter"
                MouseLeave="SidebarPeekButton_MouseLeave" />

        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Background="White"
              Panel.ZIndex="30"
              shell:WindowChrome.IsHitTestVisibleInChrome="False">
            <TextBlock Text="RSS Reader"
                       Margin="14,0,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE921;"
                        Style="{StaticResource IconActionButtonStyle}"
                        Width="34"
                        Height="34"
                    Click="MinimizeWindow_Click"
                        ToolTip="Minimize window"
                        AutomationProperties.Name="Minimize window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Content="&#xE922;"
                        Width="34"
                        Height="34"
                    Click="MaximizeWindow_Click"
                        ToolTip="Maximize window"
                        AutomationProperties.Name="Maximize window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="&#xE923;"
                        Width="34"
                        Height="34"
                    Click="RestoreWindow_Click"
                        ToolTip="Restore window"
                        AutomationProperties.Name="Restore window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="&#xE711;"
                        Style="{StaticResource DestructiveIconActionButtonStyle}"
                        Width="34"
                        Height="34"
                    Click="CloseWindow_Click"
                        ToolTip="Close window"
                        AutomationProperties.Name="Close window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
