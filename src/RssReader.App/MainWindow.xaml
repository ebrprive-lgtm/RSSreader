<Window x:Class="RssReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RSS Reader"
        Width="1380"
        Height="860"
        MinWidth="760"
        MinHeight="540"
        Background="White"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="ArticleRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F6F8F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReadLaterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Content" Value="&#xE734;" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#87938D" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#E8EEEB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArticleFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FilterBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="#E8EEEB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="{StaticResource AccentWashBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SidebarLinkTemplate">
                <Button Style="{DynamicResource SidebarButtonStyle}"
                    ToolTip="{Binding Label}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid Margin="{Binding IndentMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Label}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Count}"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ArticleRowTemplate">
            <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,5">
                <Grid MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ReadLaterToggle"
                                  IsChecked="{Binding IsSaved, Mode=TwoWay}"
                              Style="{StaticResource ReadLaterToggleStyle}"
                                  ToolTip="Click to add to read later" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ArticleRowButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source}"
                                       ToolTip="{Binding Source}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Folder}"
                                       ToolTip="{Binding Folder}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DataContext.IsSortByDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                <Run Text="  " />
                                <Run Text="{Binding Summary, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            </TextBlock>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding AgeLabel}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter TargetName="ReadLaterToggle" Property="ToolTip" Value="Remove from read later" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ArticleMagazineTemplate">
            <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,12">
                <Grid MinHeight="106">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="MagazineReadLaterToggle"
                                  IsChecked="{Binding IsSaved, Mode=TwoWay}"
                                  Style="{StaticResource ReadLaterToggleStyle}"
                                  ToolTip="Click to add to read later" />
                    <Button Grid.Column="1"
                            Style="{StaticResource ArticleRowButtonStyle}"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="154" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Height="96" Background="#E8EEEB" VerticalAlignment="Top">
                                <Border x:Name="MagazineImageFallback" Background="#E8EEEB">
                                    <TextBlock Text="&#xE91B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="24"
                                               Foreground="#87938D"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Image x:Name="MagazineArticleImage"
                                       Source="{Binding ImageUrl, TargetNullValue={x:Null}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <TextBlock Text="{Binding Title}"
                                           MaxHeight="42"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Source}"
                                               ToolTip="{Binding Source}"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="  •  " FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AgeLabel}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Folder}"
                                               Margin="10,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Visibility="{Binding DataContext.IsSortByDate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Summary}"
                                           Height="54"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                    <Setter TargetName="MagazineReadLaterToggle" Property="ToolTip" Value="Remove from read later" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                    <Setter TargetName="MagazineArticleImage" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ArticleCardTemplate">
            <Button Style="{StaticResource ArticleRowButtonStyle}"
                    Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Border Width="310"
                        Height="314"
                        Margin="0,0,12,12"
                        Background="White"
                        BorderBrush="#E1E7E3"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel>
                        <Grid Height="166" Background="#E8EEEB">
                            <Border x:Name="ImageFallback" Background="#E8EEEB">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE91B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="24"
                                               Foreground="#87938D"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="No image"
                                               Margin="0,5,0,0"
                                               FontSize="11"
                                               Foreground="#68756E" />
                                </StackPanel>
                            </Border>
                            <Image x:Name="ArticleImage"
                                Source="{Binding ImageUrl, TargetNullValue={x:Null}}"
                                   Stretch="UniformToFill" />
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="10"
                                    Padding="8,4"
                                    Background="#B0000000"
                                    CornerRadius="3">
                                <TextBlock Text="{Binding Source}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="240" />
                            </Border>
                        </Grid>
                        <StackPanel Margin="13,11,13,10">
                            <TextBlock Text="{Binding Title}"
                                       Height="46"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}"
                                       Height="48"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding AgeLabel}"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                    <Setter TargetName="ArticleImage" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8EEEB" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentWashBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SidebarIconTemplate">
            <Border Width="18"
                    Height="14"
                    BorderBrush="{StaticResource MutedTextBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentWashBrush}" />
                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource MutedTextBrush}"
                            BorderThickness="1,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#E8EEEB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ArticleViewModeStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource AccentWashBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#E8EEEB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                Grid.ColumnSpan="{Binding SidebarColumnSpan}"
                Width="{Binding SidebarPanelWidth}"
                HorizontalAlignment="Left"
                Panel.ZIndex="10"
                Background="{StaticResource SidebarBrush}"
                Padding="14,14,12,12"
                MouseEnter="SidebarPanel_MouseEnter"
                MouseLeave="SidebarPanel_MouseLeave">
            <Border.RenderTransform>
                <TranslateTransform X="-286" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="{Binding SidebarHeaderMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ProfileMenuButton"
                            Click="ProfileMenuButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,9"
                            HorizontalContentAlignment="Stretch"
                            ToolTip="Profile options">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ProfileContextMenu"
                                         Background="White"
                                         BorderBrush="#DDE3E0"
                                         BorderThickness="1"
                                         Padding="5">
                                <MenuItem Header="Preferences" Click="PreferencesMenuItem_Click" Padding="12,8" />
                                <Separator />
                                <MenuItem Header="Log Out" Click="LogoutMenuItem_Click" Padding="12,8" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveProfileName}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="SidebarPinButton"
                            Grid.Column="1"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource SidebarIconButtonStyle}"
                            ContentTemplate="{StaticResource SidebarIconTemplate}"
                            ToolTip="Hide sidebar" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PrimaryLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <Border Height="1" Background="#DDE3E0" Margin="8,12" />
                        <ItemsControl ItemsSource="{Binding ReadingLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <TextBlock Text="FEEDS"
                                   Margin="10,25,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding FeedLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <TextBlock Text="TAGS"
                                   Margin="10,23,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding TagLinks}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                        <ItemsControl ItemsSource="{Binding AdminLinks}"
                                      ItemTemplate="{StaticResource SidebarLinkTemplate}"
                                      Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2"
                           Text="RSS READER"
                           Margin="9,12,0,2"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedTextBrush}"
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,26,42,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding WorkspaceTitle}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VisibleArticles.Count, StringFormat={}{0} articles}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Visibility="{Binding IsArticleCountVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0"
                        Padding="11,7"
                        ToolTip="Refresh followed feeds" />
                <TextBox DockPanel.Dock="Right"
                         Width="290"
                         Height="38"
                         Padding="11,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Search your saved feed articles"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsSearchRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsArticleListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Content="&#xE8D4;"
                                          FontFamily="Segoe MDL2 Assets"
                                          IsChecked="{Binding UnreadOnly, Mode=TwoWay}"
                                          Style="{StaticResource ArticleFilterToggleStyle}"
                                          ToolTip="Show unread articles only"
                                          AutomationProperties.Name="Unread only"
                                          Margin="0,0,6,0" />
                            <ToggleButton Content="&#xE734;"
                                          FontFamily="Segoe MDL2 Assets"
                                          IsChecked="{Binding SavedOnly, Mode=TwoWay}"
                                          Style="{StaticResource ArticleFilterToggleStyle}"
                                          ToolTip="Show saved articles only"
                                          AutomationProperties.Name="Saved only"
                                          Margin="0,0,10,0" />
                            <Border BorderBrush="#DDE3E0" BorderThickness="1" CornerRadius="5" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Cards"
                                                 GroupName="ArticleViewMode"
                                                 IsChecked="{Binding IsCardsView, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                    <RadioButton Content="Title-Only"
                                                 GroupName="ArticleViewMode"
                                                 IsChecked="{Binding IsListView, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                    <RadioButton Content="Magazine"
                                                 GroupName="ArticleViewMode"
                                                 IsChecked="{Binding IsMagazineView, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Margin="8,0,0,0"
                                    BorderBrush="#DDE3E0"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="2"
                                    Visibility="{Binding IsArticleListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Sort by date"
                                                 GroupName="ArticleSortMode"
                                                 IsChecked="{Binding IsSortByDate, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                    <RadioButton Content="Sort by Folder"
                                                 GroupName="ArticleSortMode"
                                                 IsChecked="{Binding IsSortByFolder, Mode=TwoWay}"
                                                 Style="{StaticResource ArticleViewModeStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ArticleListView}" ItemTemplate="{StaticResource ArticleRowTemplate}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsMagazineView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ArticleListView}" ItemTemplate="{StaticResource ArticleMagazineTemplate}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsCardsView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ArticleListView}" ItemTemplate="{StaticResource ArticleCardTemplate}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="322" ItemHeight="326" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsArticleListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="No articles in this view"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding IsReadingViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="&#xE72B;  Back to list"
                            FontFamily="Segoe UI, Segoe MDL2 Assets"
                            HorizontalAlignment="Left"
                            Padding="0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AccentBrush}"
                            Command="{Binding BackToListCommand}" />
                    <ScrollViewer Grid.Row="1" Margin="0,26,0,0" VerticalScrollBarVisibility="Hidden">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedArticle.Source}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding SelectedArticle.PublishedDateLabel}"
                                       Margin="0,7,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding SelectedArticle.Title}"
                                       Margin="0,22,0,0"
                                       FontSize="31"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,26">
                                <CheckBox Content="Read later"
                                          IsChecked="{Binding SelectedArticle.IsSaved, Mode=TwoWay}"
                                          Margin="0,0,22,0" />
                                <CheckBox Content="Read"
                                      IsChecked="{Binding SelectedArticle.IsRead, Mode=TwoWay}"
                                      Margin="0,0,22,0" />
                                <Button Content="Show RAW"
                                    Click="ShowRawFeed_Click"
                                    Padding="10,4"
                                    Visibility="{Binding IsRawFeedButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <Border Height="1" Background="#E3E9E6" />
                            <TextBlock Text="{Binding SelectedArticle.Summary}"
                                       Margin="0,25,0,0"
                                       FontSize="17"
                                       LineHeight="27"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedArticle.Content}"
                                       Margin="0,18,0,0"
                                       FontSize="15"
                                       LineHeight="24"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsCatalogBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Browse the feed catalog" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CatalogFeeds.Count, StringFormat={}{0} feeds}"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding CatalogFeeds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="250" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding CategoryName, TargetNullValue=Uncategorized}"
                                                           Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding FeedUrl}"
                                                           Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Stretch">
                                                <Button Content="{Binding SubscriptionLabel}"
                                                        Command="{Binding DataContext.ToggleSubscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        MinWidth="82"
                                                        Padding="9,5" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsCatalogAdminVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Catalog Master" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="Shared feed catalog" Margin="0,7,0,12" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding CatalogManagement.ErrorMessage}"
                                       Foreground="#A33C35"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CatalogManagement.ImportMessage}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,0,0,10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,24,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Feeds" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="&#xE710;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Width="30"
                                                Height="30"
                                                ToolTip="Add feed"
                                                AutomationProperties.Name="Add feed"
                                                Click="AddFeed_Click" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CatalogManagement.Feeds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="0,11">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding FeedUrl}"
                                                                       Margin="0,4,8,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CategoryName, TargetNullValue=Uncategorized}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource AccentBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="Remove"
                                                                Command="{Binding DataContext.CatalogManagement.DeleteFeedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center"
                                                                Padding="8,5" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,24,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Categories" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="&#xE710;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Width="30"
                                                Height="30"
                                                ToolTip="Add category"
                                                AutomationProperties.Name="Add category"
                                                Click="AddCategory_Click" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CatalogManagement.Categories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Remove"
                                                            Command="{Binding DataContext.CatalogManagement.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,24,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Collections" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="&#xE710;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Width="30"
                                                Height="30"
                                                ToolTip="Add collection"
                                                AutomationProperties.Name="Add collection"
                                                Click="AddCollection_Click" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CatalogManagement.Collections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Remove"
                                                            Command="{Binding DataContext.CatalogManagement.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="8,4" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Import feeds" FontSize="15" FontWeight="SemiBold" />
                                    <Button Content="Import OPML file"
                                        Click="ImportOpml_Click"
                                        Margin="0,8,0,6"
                                        Padding="10,7" />
                                    <Button Content="Load starter pack"
                                        Command="{Binding CatalogManagement.LoadStarterPackCommand}"
                                        Margin="0,0,0,6"
                                        Padding="10,7" />

                                    <TextBlock Text="Collection feeds" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,4" />
                                    <ComboBox ItemsSource="{Binding CatalogManagement.Feeds}"
                                              SelectedItem="{Binding CatalogManagement.SelectedFeed}"
                                              DisplayMemberPath="Name"
                                              Margin="0,6,0,6"
                                              Padding="7" />
                                    <ComboBox ItemsSource="{Binding CatalogManagement.Collections}"
                                              SelectedItem="{Binding CatalogManagement.SelectedCollection}"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,0,6"
                                              Padding="7" />
                                    <Button Content="Add feed to collection"
                                            Command="{Binding CatalogManagement.AddFeedToCollectionCommand}"
                                            Padding="10,7" />
                                    <Button Content="Remove feed from collection"
                                            Command="{Binding CatalogManagement.RemoveFeedFromCollectionCommand}"
                                            Margin="0,6,0,0"
                                            Padding="10,7" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsGoToRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="560">
                        <TextBlock Text="Go to" FontSize="21" FontWeight="SemiBold" />
                        <TextBox Text="{Binding QuickQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,14,0,12"
                                 Padding="11,9"
                                 Height="40"
                                 VerticalContentAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding QuickTargets}" ItemTemplate="{StaticResource SidebarLinkTemplate}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Button x:Name="SidebarPeekButton"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8,8,0,0"
                Command="{Binding ToggleSidebarCommand}"
                Style="{StaticResource SidebarIconButtonStyle}"
                ContentTemplate="{StaticResource SidebarIconTemplate}"
                ToolTip="Show sidebar"
                Visibility="Collapsed"
                Panel.ZIndex="20"
                MouseEnter="SidebarPeekButton_MouseEnter"
                MouseLeave="SidebarPeekButton_MouseLeave" />
    </Grid>
</Window>
