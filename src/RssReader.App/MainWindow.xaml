<Window x:Class="RssReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RssReader.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    x:Name="MainWindowRoot"
        Title="RSS Reader"
    Icon="Resources/RssReader.ico"
    WindowStyle="None"
    ResizeMode="CanResize"
    WindowStartupLocation="Manual"
    AllowsTransparency="True"
    Width="1380"
    Height="860"
    MinWidth="760"
    MinHeight="540"
    Background="Transparent"
    Foreground="{DynamicResource TextBrush}"
    StateChanged="MainWindow_StateChanged"
    PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousArticleCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextArticleCommand}" />
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding ToggleReadCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding ToggleSavedCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowSharedResources.xaml" />
                <ResourceDictionary Source="Resources/MainWindowSidebarResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="WindowResizeFrame"
            Background="{DynamicResource WindowFrameBrush}"
            CornerRadius="18"
            SnapsToDevicePixels="True">
        <Border x:Name="MainWindowSurface"
                Margin="6"
                Background="{DynamicResource ContentBrush}"
                BorderBrush="{DynamicResource WindowFrameBrush}"
                BorderThickness="1"
                CornerRadius="18"
                SnapsToDevicePixels="True">
            <Grid x:Name="ShellGrid"
                  Background="Transparent"
                  SizeChanged="ShellGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarColumnWidth, Mode=TwoWay}"
                              MinWidth="{Binding SidebarColumnMinWidth}"
                              MaxWidth="480" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <local:SidebarView x:Name="SidebarView" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="10" />

        <Grid x:Name="WorkspaceGrid"
              Grid.Row="1"
              Grid.Column="1"
              Margin="38,0,42,28"
              SizeChanged="WorkspaceGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel x:Name="WorkspaceHeader" LastChildFill="False" Margin="0,0,0,22">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullPageReadingViewVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button x:Name="WorkspaceBackButton"
                        DockPanel.Dock="Left"
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource AccentBrush}"
                        Style="{StaticResource IconActionButtonStyle}"
                        ToolTip="Back to previous view (Esc)"
                        AutomationProperties.Name="Go back to previous view"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Path Width="18"
                          Height="18"
                          Data="{StaticResource BackTrailIconGeometry}"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          IsHitTestVisible="False" />
                </Button>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding WorkspaceTitle}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VisibleArticles.Count, StringFormat={}{0} articles}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Visibility="{Binding IsArticleCountVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0"
                        MinWidth="112"
                        Height="38"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        ToolTip="Refresh followed feeds"
                        AutomationProperties.Name="Refresh followed feeds">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid DockPanel.Dock="Right"
                      Width="290"
                      Height="38"
                      Margin="0,0,12,0"
                      Visibility="{Binding IsArticleSearchBoxVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox x:Name="ArticleSearchBox"
                             Padding="11,8,36,8"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search articles"
                             ToolTip="Search your saved feed articles"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <Button x:Name="ClearArticleSearchButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Content="&#xE711;"
                            Style="{StaticResource SearchClearButtonStyle}"
                            Command="{Binding ClearSearchQueryCommand}"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Clear search"
                            AutomationProperties.Name="Clear search expression" />
                </Grid>
            </DockPanel>

            <Grid x:Name="ReadingWorkspaceGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45*"
                                      MinWidth="{Binding SplitPaneListMinimumWidth}" />
                    <ColumnDefinition Width="{Binding SplitPaneDividerColumnWidth}" />
                    <ColumnDefinition Width="55*"
                                      MinWidth="{Binding SplitPaneReaderMinimumWidth}" />
                </Grid.ColumnDefinitions>
                <local:ArticleListView x:Name="ArticleListView"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="{Binding ArticleListGridColumnSpan}" />

                <GridSplitter x:Name="SplitPaneResizeSplitter"
                              Grid.Column="1"
                              Width="18"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="False"
                              Cursor="SizeWE"
                              DragCompleted="SplitPaneResizeSplitter_DragCompleted"
                              Style="{StaticResource SidebarResizeSplitterStyle}"
                              ToolTip="Drag to resize article list and reader"
                              AutomationProperties.Name="Resize article list and reader"
                              Visibility="{Binding IsSplitPaneActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border x:Name="SplitPaneEmptyReaderPlaceholder"
                        Grid.Column="2"
                        Background="{DynamicResource ContentBrush}"
                        Visibility="{Binding IsSplitPaneEmptyReaderPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="28">
                        <Path Width="28"
                              Height="24"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,12"
                              Data="{StaticResource SplitPaneIconGeometry}"
                              Stroke="{DynamicResource MutedTextBrush}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="Choose an article to read"
                                   HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Select an item from the list to show it here."
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
                <local:ArticleReaderView x:Name="ArticleReaderView"
                                         Grid.Column="{Binding ArticleReaderGridColumn}"
                                         Grid.ColumnSpan="{Binding ArticleReaderGridColumnSpan}" />

                <local:CatalogBrowserView x:Name="CatalogBrowserView"
                                          Grid.ColumnSpan="3" />

                <local:CatalogAdminView x:Name="CatalogAdminView"
                                        Grid.ColumnSpan="3" />

            </Grid>
        </Grid>


        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Background="{DynamicResource ContentBrush}"
              Panel.ZIndex="30"
              shell:WindowChrome.IsHitTestVisibleInChrome="False">
            <TextBlock Text="RSS Reader"
                       Margin="14,0,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}" />
            <local:FeedWarningsView x:Name="FeedWarningsView"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,122,0"
                                    Panel.ZIndex="31" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#xE921;"
                        Style="{StaticResource IconActionButtonStyle}"
                        Width="34"
                        Height="34"
                    Click="MinimizeWindow_Click"
                        ToolTip="Minimize window"
                        AutomationProperties.Name="Minimize window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Content="&#xE922;"
                        Width="34"
                        Height="34"
                    Click="MaximizeWindow_Click"
                        ToolTip="Maximize window"
                        AutomationProperties.Name="Maximize window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="&#xE923;"
                        Width="34"
                        Height="34"
                    Click="RestoreWindow_Click"
                        ToolTip="Restore window"
                        AutomationProperties.Name="Restore window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconActionButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="&#xE711;"
                        Style="{StaticResource DestructiveIconActionButtonStyle}"
                        Width="34"
                        Height="34"
                    Click="CloseWindow_Click"
                        ToolTip="Close window"
                        AutomationProperties.Name="Close window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>
        <GridSplitter x:Name="SidebarResizeSplitter"
                      Grid.Row="1"
                      Grid.Column="0"
                      Width="8"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="CurrentAndNext"
                      ShowsPreview="False"
                      Cursor="SizeWE"
                      Style="{StaticResource SidebarResizeSplitterStyle}"
                      ToolTip="Drag to resize sidebar"
                      AutomationProperties.Name="Resize sidebar"
                      Visibility="{Binding IsSidebarPinned, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Panel.ZIndex="11" />
            </Grid>
        </Border>
    </Border>
</Window>
