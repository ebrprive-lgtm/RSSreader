<Window x:Class="RssReader.App.ProfileChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RSS Reader"
        WindowStyle="None"
        Width="520"
        Height="620"
        MinWidth="440"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="100"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ProfileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeleteProfileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource DestructiveWashBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DestructiveBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DeleteBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeleteBorder" Property="Background" Value="{DynamicResource DestructiveWashBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DeleteBorder" Property="Background" Value="{DynamicResource NeutralPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

        <Border Margin="8"
            Background="{DynamicResource ContentBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,8,0,28">
            <StackPanel>
                <TextBlock Text="RSS READER"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="12"
                           FontWeight="Bold" />
                <TextBlock Text="Your reading space"
                           Margin="0,8,0,0"
                           FontSize="25"
                           FontWeight="SemiBold" />
            </StackPanel>
            <Button Content="&#xE711;"
                    Style="{StaticResource DestructiveIconActionButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ToolTip="Close profile chooser"
                    AutomationProperties.Name="Close profile chooser"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseWindow_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        VerticalAlignment="Center"
                        MaxWidth="340"
                        HorizontalAlignment="Center">
                <TextBlock Text="Create new profile"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <Button Content="Create new profile"
                        Command="{Binding CreateProfileCommand}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="0,18,0,0" />
            </StackPanel>

            <Grid Visibility="{Binding IsProfileListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Choose a profile"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Style="{StaticResource ProfileButtonStyle}"
                                            Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentWashBrush}">
                                                <TextBlock Text="{Binding Name, StringFormat={}{0:0}}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="Catalog management"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Visibility="{Binding IsCatalogMaster, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="DeleteProfileButton"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,8"
                                            Style="{StaticResource DeleteProfileButtonStyle}"
                                            Click="DeleteProfile_Click"
                                            ToolTip="Delete profile"
                                            AutomationProperties.Name="Delete profile"
                                            Visibility="Collapsed">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.IsDeleteModeActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                        <Condition Binding="{Binding IsCatalogMaster}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="DeleteProfileButton" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2"
                        Content="Create new profile"
                        Command="{Binding CreateProfileCommand}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="0,14,0,0" />
            </Grid>

            <StackPanel Visibility="{Binding IsCreatingProfile, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Create new profile" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
                <TextBlock Text="Profile name" FontWeight="SemiBold" />
                <TextBox x:Name="CreateProfileNameBox"
                         AutomationProperties.Name="Profile name"
                         Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,14"
                         Padding="10,8"
                         MaxLength="40" />
                <TextBlock Text="Password (optional)" FontWeight="SemiBold" />
                <PasswordBox x:Name="CreatePasswordBox"
                             AutomationProperties.Name="Create profile password"
                             PasswordChanged="CreatePasswordBox_PasswordChanged"
                             Margin="0,6,0,14"
                             Padding="10,8" />
                <TextBlock Text="Recovery email (optional)" FontWeight="SemiBold" />
                <TextBox x:Name="RecoveryEmailBox"
                         AutomationProperties.Name="Recovery email"
                         Text="{Binding RecoveryEmail, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,4"
                         Padding="10,8" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DestructiveBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancel" Click="CancelCreate_Click" Style="{StaticResource SecondaryActionButtonStyle}" Padding="14,9" Margin="0,0,8,0" />
                    <Button Content="Create profile"
                            Command="{Binding SubmitCreateProfileCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsUnlockingProfile, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Unlock profile" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
                <PasswordBox x:Name="UnlockPasswordBox"
                             AutomationProperties.Name="Profile password"
                             PasswordChanged="UnlockPasswordBox_PasswordChanged"
                             Padding="10,8" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DestructiveBrush}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancel" Click="CancelUnlock_Click" Style="{StaticResource SecondaryActionButtonStyle}" Padding="14,9" Margin="0,0,8,0" />
                    <Button Content="Unlock"
                            Command="{Binding ConfirmUnlockCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>