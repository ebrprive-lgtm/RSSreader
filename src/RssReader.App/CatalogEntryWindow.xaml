<Window x:Class="RssReader.App.CatalogEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        Width="440"
        SizeToContent="Height"
        MinHeight="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
        <Border Margin="8"
            Background="{StaticResource ContentBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="DialogHeading"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <Button x:Name="CloseWindowButton"
            Grid.Column="1"
            Content="&#xE711;"
            FontFamily="Segoe MDL2 Assets"
            FontSize="13"
            Width="32"
            Height="32"
            Padding="0"
            Margin="8,0,0,0"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{StaticResource MutedTextBrush}"
            Style="{StaticResource IconActionButtonStyle}"
            AutomationProperties.Name="Close dialog"
            ToolTip="Close"
            shell:WindowChrome.IsHitTestVisibleInChrome="True"
            Click="CloseWindowButton_Click" />
        <StackPanel x:Name="FeedFields" Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="FeedNameBox" Margin="0,5,0,12" Padding="9,7" />
            <TextBlock Text="Feed URL" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="FeedUrlBox" Margin="0,5,0,12" Padding="9,7" />
            <TextBlock Text="Publisher website (optional)" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="FeedWebsiteUrlBox" Margin="0,5,0,12" Padding="9,7" />
            <TextBlock Text="Description (optional)" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="FeedDescriptionBox" Margin="0,5,0,12" Padding="9,7" />
            <TextBlock Text="Category (optional)" FontSize="12" FontWeight="SemiBold" />
            <ComboBox x:Name="FeedCategoryBox"
                      ItemsSource="{Binding Categories}"
                      DisplayMemberPath="Name"
                      Margin="0,5,0,0"
                      Padding="7" />
        </StackPanel>
        <StackPanel x:Name="CategoryFields" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
            <TextBlock Text="Category name" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="CategoryNameBox"
                     Margin="0,5,0,0"
                     Padding="9,7"
                     Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel x:Name="CollectionFields" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
            <TextBlock Text="Collection name" FontSize="12" FontWeight="SemiBold" />
            <TextBox x:Name="CollectionNameBox" Margin="0,5,0,0" Padding="9,7" />
        </StackPanel>
        <TextBlock Grid.Row="2"
               Grid.ColumnSpan="2"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource DestructiveBrush}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MergeCategoryButton"
                    Content="{Binding MergeCategoryButtonLabel}"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Padding="10,7"
                    AutomationProperties.Name="Merge category into existing category"
                    ToolTip="{Binding MergeCategoryButtonLabel}"
                    Visibility="{Binding CanMergeCategory, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="MergeCategoryButton_Click" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" MinWidth="82" Padding="10,7" Margin="0,0,8,0" />
                <Button x:Name="SubmitButton" Content="Add" IsDefault="True" Style="{StaticResource PrimaryActionButtonStyle}" Click="SubmitButton_Click" MinWidth="82" Padding="10,7" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>