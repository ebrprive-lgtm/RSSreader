<Application x:Class="RssReader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RssReader.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/AppThemeResources.xaml" />
                <ResourceDictionary Source="Resources/AppMenuResources.xaml" />
                <ResourceDictionary Source="Resources/AppScrollBarResources.xaml" />
                <ResourceDictionary Source="Resources/AppSelectionResources.xaml" />
                <ResourceDictionary Source="Resources/AppTabResources.xaml" />
                <ResourceDictionary Source="Resources/AppButtonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
