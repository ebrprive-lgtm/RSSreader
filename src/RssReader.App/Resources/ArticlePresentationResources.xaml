<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:RssReader.App"
                    xmlns:domain="clr-namespace:RssReader.Domain;assembly=RssReader.Domain"
                    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <ContextMenu x:Key="ArticleActionsContextMenu"
                 x:Shared="False"
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="Open in reader"
                  Command="{Binding PlacementTarget.Tag.OpenArticleInReaderCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding}" />
        <MenuItem Header="Open original source"
                  Command="{Binding PlacementTarget.Tag.OpenArticleSourceCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding}" />
        <Separator />
        <MenuItem Header="Toggle read status"
                  Command="{Binding PlacementTarget.Tag.ToggleArticleReadCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding}" />
        <MenuItem Header="Toggle saved status"
                  Command="{Binding PlacementTarget.Tag.ToggleArticleSavedCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding}" />
        <MenuItem Header="Show source feed"
                  Command="{Binding PlacementTarget.Tag.NavigateToArticleFeedCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{Binding}" />
    </ContextMenu>
    <Style x:Key="ArticleMetadataPillButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource PublisherTopicPillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PublisherTopicPillTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="MaxWidth" Value="88" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="PillBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ArticleReadStatusMarkerTemplate">
        <Border Background="{DynamicResource AccentWashBrush}"
                CornerRadius="4"
                Padding="5,2"
                ToolTip="This article has been read"
                AutomationProperties.Name="Read article">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="9"
                           Foreground="{DynamicResource SuccessBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Read"
                           Margin="3,0,0,0"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SuccessBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ArticleTopicPillTemplate">
        <Grid>
            <Button x:Name="ArticleTopicPillButton"
                    Style="{StaticResource ArticleMetadataPillButtonStyle}"
                    Command="{Binding DataContext.SelectArticleTopicCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}">
                <TextBlock Text="{Binding Name}"
                           FontSize="10"
                   Foreground="{DynamicResource PublisherTopicPillTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Button>
            <Border x:Name="AdditionalTopicsPill"
                    Background="{DynamicResource PublisherTopicPillBrush}"
                    CornerRadius="7"
                    Padding="6,2"
                    Margin="0,0,4,0"
                    MaxWidth="88"
                    Visibility="Collapsed">
                <TextBlock Text="{Binding Name}"
                           FontSize="10"
                   Foreground="{DynamicResource PublisherTopicPillTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                <Setter TargetName="ArticleTopicPillButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AdditionalTopicsPill" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="ArticleFeedTagPillTemplate">
        <Grid>
            <Button x:Name="ArticleFeedTagPillButton"
                    Style="{StaticResource ArticleMetadataPillButtonStyle}"
                    Background="{DynamicResource UserFeedTagPillBrush}"
                    Foreground="{DynamicResource UserFeedTagPillTextBrush}"
                    Command="{Binding DataContext.SelectFeedTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}">
                <TextBlock Text="{Binding Name}"
                           FontSize="10"
                   Foreground="{DynamicResource UserFeedTagPillTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Button>
            <Border x:Name="AdditionalFeedTagsPill"
                    Background="{DynamicResource UserFeedTagPillBrush}"
                    CornerRadius="7"
                    Padding="6,2"
                    Margin="0,0,4,0"
                    MaxWidth="88"
                    Visibility="Collapsed">
                <TextBlock Text="{Binding Name}"
                           FontSize="10"
                   Foreground="{DynamicResource UserFeedTagPillTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                <Setter TargetName="ArticleFeedTagPillButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AdditionalFeedTagsPill" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="ArticleRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ReadLaterToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                        <Path x:Name="BookmarkIcon"
                              Width="16"
                              Height="18"
                              Stretch="Fill"
                              Data="M 2,1 L 14,1 L 14,17 L 8,13 L 2,17 Z"
                              Fill="Transparent"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="BookmarkIcon" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="ArticleRowTemplate">
        <Border x:Name="ArticleRowSurface"
                Background="Transparent"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,5">
            <Grid x:Name="ArticleRowContent" MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="UnreadMarker"
                         Width="5"
                         Height="5"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}"
                         AutomationProperties.Name="Unread article" />
                <ToggleButton x:Name="ReadLaterToggle"
                              IsChecked="{Binding IsSaved, Mode=TwoWay}"
                              Style="{StaticResource ReadLaterToggleStyle}"
                              AutomationProperties.Name="{Binding ReadLaterAutomationName}"
                              ToolTip="Click to add to read later" />
                <CheckBox x:Name="ArticleRowBulkSelectionToggle"
                          IsChecked="{Binding IsBulkSelected, Mode=TwoWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding DataContext.IsBulkSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.Name="{Binding BulkSelectionAutomationName}"
                          ToolTip="Select this article" />
                <Button Grid.Column="1"
                        Style="{StaticResource ArticleRowButtonStyle}"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        ContextMenu="{StaticResource ArticleActionsContextMenu}"
                        AutomationProperties.Name="{Binding Title}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Source}"
                                   ToolTip="{Binding Source}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Folder}"
                                   ToolTip="{Binding Folder}"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding DataContext.IsSortByFolder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock x:Name="ArticleRowTitle"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding Title, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                        <ContentControl x:Name="ArticleRowReadMarker"
                                        Grid.Column="3"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        ContentTemplate="{StaticResource ArticleReadStatusMarkerTemplate}"
                                        Visibility="Collapsed" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding FreshnessLabel}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                </Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRead}" Value="True">
                <Setter TargetName="UnreadMarker" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ArticleRowReadMarker" Property="Visibility" Value="Visible" />
                <Setter TargetName="ArticleRowTitle" Property="FontWeight" Value="Normal" />
                <Setter TargetName="ArticleRowTitle" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsBulkSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="ReadLaterToggle" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="UnreadMarker" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="ArticleRowSurface" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="ArticleRowSurface" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                <Setter TargetName="ReadLaterToggle" Property="ToolTip" Value="Remove from read later" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ArticleListDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                         Value="{x:Static domain:ProfileArticleListDensity.Compact}">
                <Setter TargetName="ArticleRowSurface" Property="Padding" Value="0,2" />
                <Setter TargetName="ArticleRowContent" Property="MinHeight" Value="30" />
                <Setter TargetName="ArticleRowTitle" Property="FontSize" Value="12" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ArticleListDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                         Value="{x:Static domain:ProfileArticleListDensity.Spacious}">
                <Setter TargetName="ArticleRowSurface" Property="Padding" Value="0,8" />
                <Setter TargetName="ArticleRowContent" Property="MinHeight" Value="44" />
                <Setter TargetName="ArticleRowTitle" Property="FontSize" Value="14" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="ArticleMagazineTemplate">
        <Border x:Name="MagazineArticleSurface"
                BorderBrush="{DynamicResource SeparatorBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,12">
            <Grid x:Name="MagazineArticleContent" MinHeight="106">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="MagazineReadLaterToggle"
                              IsChecked="{Binding IsSaved, Mode=TwoWay}"
                              Style="{StaticResource ReadLaterToggleStyle}"
                              AutomationProperties.Name="{Binding ReadLaterAutomationName}"
                              ToolTip="Click to add to read later" />
                <CheckBox x:Name="MagazineBulkSelectionToggle"
                          IsChecked="{Binding IsBulkSelected, Mode=TwoWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding DataContext.IsBulkSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.Name="{Binding BulkSelectionAutomationName}"
                          ToolTip="Select this article" />
                <Button Grid.Column="1"
                        Style="{StaticResource ArticleRowButtonStyle}"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        ContextMenu="{StaticResource ArticleActionsContextMenu}"
                        AutomationProperties.Name="{Binding Title}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="154" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="MagazineImageRegion"
                              Grid.Column="0"
                              Height="96"
                              Background="{DynamicResource NeutralHoverBrush}"
                              VerticalAlignment="Top">
                            <Border x:Name="MagazineImageFallback" Background="{DynamicResource NeutralHoverBrush}">
                                <TextBlock Text="&#xE91B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="24"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Image x:Name="MagazineArticleImage"
                                   Source="{Binding ImageUrl, TargetNullValue={x:Null}}"
                                   Stretch="UniformToFill" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock x:Name="MagazineTitle"
                                       Text="{Binding Title}"
                                       MaxHeight="42"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Source}"
                                           ToolTip="{Binding Source}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="  •  " FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding FreshnessLabel}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <ContentControl x:Name="MagazineReadMarker"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ContentTemplate="{StaticResource ArticleReadStatusMarkerTemplate}"
                                                Visibility="Collapsed" />
                                <TextBlock Text="{Binding Folder}"
                                           Margin="10,0,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="{Binding DataContext.IsSortByFolder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock x:Name="MagazineSummary"
                                       Text="{Binding Summary}"
                                       Height="54"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding TopicChips}"
                                          Margin="0,4,0,0"
                                          ItemTemplate="{StaticResource ArticleTopicPillTemplate}"
                                          ToolTip="{Binding FullTopicSummary}"
                                          AutomationProperties.Name="Publisher topics"
                                          Visibility="{Binding HasTopics, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding FeedTagChips}"
                                          Margin="0,3,0,0"
                                          ItemTemplate="{StaticResource ArticleFeedTagPillTemplate}"
                                          ToolTip="{Binding FullFeedTagSummary}"
                                          AutomationProperties.Name="User tags"
                                          Visibility="{Binding HasFeedTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsBulkSelectionMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter TargetName="MagazineReadLaterToggle" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                <Setter TargetName="MagazineReadLaterToggle" Property="ToolTip" Value="Remove from read later" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRead}" Value="True">
                <Setter TargetName="MagazineReadMarker" Property="Visibility" Value="Visible" />
                <Setter TargetName="MagazineTitle" Property="FontWeight" Value="Normal" />
                <Setter TargetName="MagazineTitle" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                <Setter TargetName="MagazineArticleImage" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ArticleListDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                         Value="{x:Static domain:ProfileArticleListDensity.Compact}">
                <Setter TargetName="MagazineArticleSurface" Property="Padding" Value="0,8" />
                <Setter TargetName="MagazineArticleContent" Property="MinHeight" Value="86" />
                <Setter TargetName="MagazineImageRegion" Property="Height" Value="76" />
                <Setter TargetName="MagazineTitle" Property="MaxHeight" Value="36" />
                <Setter TargetName="MagazineSummary" Property="Height" Value="38" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ArticleListDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                         Value="{x:Static domain:ProfileArticleListDensity.Spacious}">
                <Setter TargetName="MagazineArticleSurface" Property="Padding" Value="0,16" />
                <Setter TargetName="MagazineArticleContent" Property="MinHeight" Value="130" />
                <Setter TargetName="MagazineImageRegion" Property="Height" Value="112" />
                <Setter TargetName="MagazineTitle" Property="MaxHeight" Value="52" />
                <Setter TargetName="MagazineSummary" Property="Height" Value="70" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="ArticleCardTemplate">
        <Grid x:Name="ArticleCardRoot"
              Width="310"
              Height="370"
              Margin="0,0,12,12">
            <Button x:Name="ArticleCardButton"
                    Style="{StaticResource ArticleRowButtonStyle}"
                    Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ContextMenu="{StaticResource ArticleActionsContextMenu}"
                    AutomationProperties.Name="{Binding Title}">
                <Border x:Name="ArticleCardSurface"
                        Width="310"
                        Height="370"
                        Background="{DynamicResource ContentBrush}"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid x:Name="ArticleCardImageRegion" Height="166">
                            <Border x:Name="ImageFallback"
                                    CornerRadius="11,11,0,0"
                                    Background="{DynamicResource NeutralHoverBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="62"
                                            Height="62"
                                            CornerRadius="31"
                                    Background="{DynamicResource AccentWashBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding SourceInitials}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border Margin="0,9,0,0"
                                            Padding="9,3"
                                    Background="{DynamicResource WindowBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Visibility="{Binding DataContext.IsSortByFolder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Folder}"
                                                   MaxWidth="180"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ArticleImage" CornerRadius="11,11,0,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CardImageUrl, TargetNullValue={x:Null}}"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="ImageGradient"
                                    CornerRadius="11,11,0,0"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.35" />
                                        <GradientStop Color="#68000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="10"
                                    Padding="8,4"
                                    Background="#B0000000"
                                    CornerRadius="3">
                                <TextBlock Text="{Binding Source}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="240" />
                            </Border>
                        </Grid>
                        <StackPanel x:Name="ArticleCardTextArea" Margin="13,11,13,10">
                            <TextBlock x:Name="ArticleCardTitle"
                                       Text="{Binding Title}"
                                       Height="46"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="WordEllipsis"
                                       ToolTip="{Binding Title}" />
                            <TextBlock x:Name="ArticleCardSummary"
                                       Text="{Binding Summary}"
                                       Height="48"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="WordEllipsis"
                                       ToolTip="{Binding Summary}" />
                            <TextBlock Text="{Binding FreshnessLabel}"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <ItemsControl ItemsSource="{Binding CardTopicChips}"
                                          Margin="0,4,0,0"
                                          ItemTemplate="{StaticResource ArticleTopicPillTemplate}"
                                          ToolTip="{Binding FullTopicSummary}"
                                          AutomationProperties.Name="Publisher topics"
                                          Visibility="{Binding HasTopics, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding FeedTagChips}"
                                          Margin="0,3,0,0"
                                          ItemTemplate="{StaticResource ArticleFeedTagPillTemplate}"
                                          ToolTip="{Binding FullFeedTagSummary}"
                                          AutomationProperties.Name="User tags"
                                          Visibility="{Binding HasFeedTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
            <Ellipse x:Name="ArticleCardUnreadIndicator"
                     Width="8"
                     Height="8"
                     Margin="0,11,46,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Fill="{DynamicResource AccentBrush}"
                     IsHitTestVisible="False"
                     ToolTip="Unread article"
                     AutomationProperties.Name="Unread article" />
            <ContentControl x:Name="ArticleCardReadIndicator"
                            Margin="0,7,46,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ContentTemplate="{StaticResource ArticleReadStatusMarkerTemplate}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
            <ToggleButton x:Name="ArticleCardSaveToggle"
                          Width="30"
                          Height="30"
                          Margin="0,8,8,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Background="{DynamicResource ContentBrush}"
                          IsChecked="{Binding IsSaved, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding ReadLaterAutomationName}"
                          ToolTip="{Binding ReadLaterAutomationName}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ReadLaterToggleStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <CheckBox x:Name="ArticleCardBulkSelectionToggle"
                      Width="20"
                      Height="20"
                      Margin="8,8,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      IsChecked="{Binding IsBulkSelected, Mode=TwoWay}"
                      Visibility="{Binding DataContext.IsBulkSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.Name="{Binding BulkSelectionAutomationName}"
                      ToolTip="Select this article" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding CardImageUrl}" Value="{x:Null}">
                <Setter TargetName="ArticleImage" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ImageGradient" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRead}" Value="True">
                <Setter TargetName="ArticleCardUnreadIndicator" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="ArticleCardReadIndicator" Property="Visibility" Value="Visible" />
                <Setter TargetName="ArticleCardTitle" Property="FontWeight" Value="Normal" />
                <Setter TargetName="ArticleCardTitle" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                <Setter TargetName="ArticleCardSaveToggle" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ArticleCardRoot}" Value="True">
                <Setter TargetName="ArticleCardSaveToggle" Property="Visibility" Value="Visible" />
                <Setter TargetName="ArticleCardSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="ArticleCardRoot" Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-2" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ArticleCardRoot}" Value="True">
                <Setter TargetName="ArticleCardSaveToggle" Property="Visibility" Value="Visible" />
                <Setter TargetName="ArticleCardSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="ArticleCardSurface" Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ArticleListDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                         Value="{x:Static domain:ProfileArticleListDensity.Compact}">
                <Setter TargetName="ArticleCardRoot" Property="Width" Value="276" />
                <Setter TargetName="ArticleCardRoot" Property="Height" Value="336" />
                <Setter TargetName="ArticleCardRoot" Property="Margin" Value="0,0,10,10" />
                <Setter TargetName="ArticleCardSurface" Property="Width" Value="276" />
                <Setter TargetName="ArticleCardSurface" Property="Height" Value="336" />
                <Setter TargetName="ArticleCardImageRegion" Property="Height" Value="144" />
                <Setter TargetName="ArticleCardTextArea" Property="Margin" Value="11,8,11,8" />
                <Setter TargetName="ArticleCardTitle" Property="Height" Value="42" />
                <Setter TargetName="ArticleCardSummary" Property="Height" Value="42" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.ArticleListDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                         Value="{x:Static domain:ProfileArticleListDensity.Spacious}">
                <Setter TargetName="ArticleCardRoot" Property="Width" Value="332" />
                <Setter TargetName="ArticleCardRoot" Property="Height" Value="396" />
                <Setter TargetName="ArticleCardRoot" Property="Margin" Value="0,0,14,14" />
                <Setter TargetName="ArticleCardSurface" Property="Width" Value="332" />
                <Setter TargetName="ArticleCardSurface" Property="Height" Value="396" />
                <Setter TargetName="ArticleCardImageRegion" Property="Height" Value="180" />
                <Setter TargetName="ArticleCardTextArea" Property="Margin" Value="15,13,15,12" />
                <Setter TargetName="ArticleCardTitle" Property="Height" Value="52" />
                <Setter TargetName="ArticleCardSummary" Property="Height" Value="58" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
