<Window x:Class="RssReader.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        Width="900"
        Height="680"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PreferenceNavigationStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="NavigationBorder"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    Margin="-2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource NeutralHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource AccentWashBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreferenceOptionStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" MinHeight="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="RadioRing"
                                     Width="15"
                                     Height="15"
                                     Stroke="{DynamicResource ControlBorderBrush}"
                                     StrokeThickness="1"
                                     Fill="{DynamicResource ContentBrush}"
                                     VerticalAlignment="Center" />
                            <Ellipse x:Name="RadioDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{DynamicResource AccentBrush}"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="9,0,0,0"
                                              ContentSource="Content"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                            <Border x:Name="FocusRing"
                                    Margin="-2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioRing" Property="Fill" Value="{DynamicResource NeutralHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioRing" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Border Background="{DynamicResource ContentBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,1,0" Padding="16,22">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Preferences"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="8,0,0,20" />
                <StackPanel>
                    <RadioButton x:Name="GeneralNavigation"
                                 Content="General"
                                 GroupName="PreferenceSections"
                                 IsChecked="True"
                                 Style="{StaticResource PreferenceNavigationStyle}"
                                 Click="GeneralNavigation_Click" />
                    <RadioButton x:Name="AppearanceNavigation"
                                 Content="Appearance"
                                 GroupName="PreferenceSections"
                                 Style="{StaticResource PreferenceNavigationStyle}"
                                 Click="AppearanceNavigation_Click" />
                    <RadioButton x:Name="ReadingNavigation"
                                 Content="Reading"
                                 GroupName="PreferenceSections"
                                 Style="{StaticResource PreferenceNavigationStyle}"
                                 Click="ReadingNavigation_Click" />
                    <RadioButton x:Name="DebuggingNavigation"
                                 Content="Debugging"
                                 GroupName="PreferenceSections"
                                 Style="{StaticResource PreferenceNavigationStyle}"
                                 Click="DebuggingNavigation_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SectionTitle"
                       Text="General"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Margin="0,0,0,16" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="GeneralPanel">
                        <TextBlock Text="Start page" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Choose the page shown when you open this profile."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,10" />
                        <RadioButton x:Name="StartTodayOption" Content="Today" GroupName="StartPage" Style="{StaticResource PreferenceOptionStyle}" />
                        <RadioButton x:Name="StartFirstFolderOption" Content="First folder" GroupName="StartPage" Style="{StaticResource PreferenceOptionStyle}" />
                        <RadioButton x:Name="StartAllOption" Content="All" GroupName="StartPage" Style="{StaticResource PreferenceOptionStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                        <TextBlock Text="Default presentation" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Choose how articles appear when this profile opens."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,10" />
                        <RadioButton x:Name="PresentationTitleOnlyOption" Content="Title-only view" GroupName="Presentation" Style="{StaticResource PreferenceOptionStyle}" />
                        <RadioButton x:Name="PresentationMagazineOption" Content="Magazine view" GroupName="Presentation" Style="{StaticResource PreferenceOptionStyle}" />
                        <RadioButton x:Name="PresentationCardsOption" Content="Cards view" GroupName="Presentation" Style="{StaticResource PreferenceOptionStyle}" />
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,24,0,20" />
                        <TextBlock Text="Default sort" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Choose the article order used in this profile."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,10" />
                        <RadioButton x:Name="SortFolderOption" Content="By folder" GroupName="ArticleSort" Style="{StaticResource PreferenceOptionStyle}" />
                        <RadioButton x:Name="SortNewestOption" Content="Newest first" GroupName="ArticleSort" Style="{StaticResource PreferenceOptionStyle}" />
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,24,0,20" />
                        <CheckBox x:Name="LimitArticleWidthCheckBox"
                                  Content="Limit article width to 900 px"
                                  AutomationProperties.Name="Limit article width to 900 pixels"
                                  FontSize="13"
                                  Padding="2" />
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,24,0,20" />
                        <TextBlock Text="Application theme" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Choose the color theme used throughout the interface."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap" />
                        <ComboBox x:Name="ReaderThemeComboBox"
                                  AutomationProperties.Name="Application theme"
                                  Width="190"
                                  HorizontalAlignment="Left"
                                  Padding="7">
                            <ComboBoxItem Content="Light" Tag="0" />
                            <ComboBoxItem Content="Dark" Tag="1" />
                            <ComboBoxItem Content="Warm" Tag="2" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="ReadingPanel" Visibility="Collapsed">
                        <TextBlock Text="Article-list density" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Use the current layout by default, or choose a denser or roomier list."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap" />
                        <ComboBox x:Name="ArticleListDensityComboBox"
                                  AutomationProperties.Name="Article-list density"
                                  Width="190"
                                  HorizontalAlignment="Left"
                                  Padding="7">
                            <ComboBoxItem Content="Current layout" Tag="0" />
                            <ComboBoxItem Content="Compact" Tag="1" />
                            <ComboBoxItem Content="Spacious" Tag="2" />
                        </ComboBox>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,24,0,20" />
                        <TextBlock Text="Article visibility" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Control which articles appear in your reading lists."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,12" />
                        <CheckBox x:Name="HideReadArticlesCheckBox"
                                  Content="Hide read articles"
                                  AutomationProperties.Name="Hide read articles"
                                  FontSize="13"
                                  Padding="2" />
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,24,0,20" />
                        <TextBlock Text="Folder article limit" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Maximum articles shown per feed inside a folder."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,10"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="FolderArticleLimitBox"
                                 AutomationProperties.Name="Folder article limit"
                                 Width="110"
                                 HorizontalAlignment="Left"
                                 Padding="8,6"
                                 MaxLength="3"
                                 ToolTip="Enter a number from 1 to 100" />
                        <TextBlock x:Name="ValidationMessage"
                                   Foreground="{DynamicResource DestructiveBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,24,0,20" />
                        <TextBlock Text="Feed updates" FontSize="13" FontWeight="SemiBold" />
                        <CheckBox x:Name="RefreshFeedsWhenOpenedCheckBox"
                                  Content="Refresh feeds when opening a feed or folder"
                                  AutomationProperties.Name="Refresh feeds when opening a feed or folder"
                                  FontSize="13"
                                  Margin="0,10,0,0"
                                  Padding="2" />
                        <TextBlock Text="Newly followed feeds refresh the first time they are opened."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="24,3,0,12"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Refresh on a timer" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Periodically check all feeds followed by this profile."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap" />
                        <ComboBox x:Name="AutoRefreshIntervalComboBox"
                                  AutomationProperties.Name="Refresh interval"
                                  Width="190"
                                  HorizontalAlignment="Left"
                                  Padding="7">
                            <ComboBoxItem Content="Off" Tag="0" />
                            <ComboBoxItem Content="Every 15 minutes" Tag="15" />
                            <ComboBoxItem Content="Every 30 minutes" Tag="30" />
                            <ComboBoxItem Content="Every hour" Tag="60" />
                            <ComboBoxItem Content="Every 4 hours" Tag="240" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="DebuggingPanel" Visibility="Collapsed">
                        <TextBlock Text="Feed diagnostics" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Inspect the source XML used to parse an article's feed."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap" />
                        <CheckBox x:Name="ShowRawFeedButtonCheckBox"
                                  Content="Show XML in the article viewer"
                                  AutomationProperties.Name="Show XML in the article viewer"
                                  FontSize="13"
                                  Padding="2" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="{Binding Name, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" MinWidth="82" Padding="12,7" Margin="0,0,8,0" />
                    <Button x:Name="SavePreferencesButton" Content="Save" IsDefault="True" Style="{StaticResource PrimaryActionButtonStyle}" MinWidth="82" Padding="12,7" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
        <Button Grid.Column="1"
                Content="&#xE711;"
                Style="{StaticResource IconActionButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,4,8,0"
                ToolTip="Close dialog"
                AutomationProperties.Name="Close dialog"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="CloseWindow_Click" />
        </Grid>
        </Border>
    </Grid>
</Window>