<Window x:Class="RssReader.App.CatalogFeedPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feed preview"
        Width="620"
        Height="560"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="White"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteCatalogFeedButton"
                    Content="&#xE74D;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Width="34"
                    Height="34"
                    Padding="0"
                    Margin="0,0,6,0"
                    Background="#F4F6F5"
                    BorderBrush="#D5DEDA"
                    AutomationProperties.Name="Delete feed from catalog"
                    ToolTip="Delete feed from catalog"
                    Visibility="Collapsed"
                    Click="DeleteFeedButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FCE8E6" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D66A62" />
                                <Setter Property="Foreground" Value="#A33C35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F3D1CE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CheckFeedButton"
                    Content="Check Feed"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Width="98"
                    Height="34"
                    Padding="8,0"
                    Margin="0,0,6,0"
                    Background="#EAF4EC"
                    BorderBrush="#B7D8C0"
                    Foreground="#218739"
                    AutomationProperties.Name="Check feed"
                    ToolTip="Check feed health"
                    Visibility="Collapsed"
                    Click="CheckFeedButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D7EBDD" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#86B995" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C4E0CB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="ClosePreviewButton"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    IsCancel="True"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="Close feed preview"
                    ToolTip="Close preview"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#F4F6F5"
                                BorderBrush="#D5DEDA"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FCE8E6" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D66A62" />
                                <Setter Property="Foreground" Value="#A33C35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F3D1CE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,4,0,14">
            <TextBlock x:Name="FeedNameText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="FeedCategoryText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
            <TextBlock x:Name="FeedDescriptionText" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ProgressBar x:Name="LoadingProgressBar"
                     Grid.Row="2"
                     Height="3"
                     Margin="0,0,0,8"
                     IsIndeterminate="True" />
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PreviewItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E7E4" BorderThickness="0,0,0,1" Padding="0,11">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PublishedAt, StringFormat={}{0:MMM d, yyyy}}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyStateText"
                       Text="No recent articles are available in this feed."
                       Margin="0,12,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Visibility="Collapsed" />
        </Grid>
        <TextBlock x:Name="ErrorMessageText"
                   Grid.Row="4"
                   Margin="0,10,0,0"
                   Foreground="#A33C35"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </Grid>
</Window>