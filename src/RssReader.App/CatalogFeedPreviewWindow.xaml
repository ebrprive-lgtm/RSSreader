<Window x:Class="RssReader.App.CatalogFeedPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="620"
        Height="560"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBrush}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
        <Border Margin="6"
            Background="{DynamicResource ContentBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteCatalogFeedButton"
                    Content="&#xE74D;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    Width="34"
                    Height="34"
                    Padding="0"
                    Margin="0,0,6,0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    AutomationProperties.Name="Delete feed from catalog"
                    ToolTip="Delete feed from catalog"
                    Visibility="Collapsed"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="DeleteFeedButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DestructiveWashBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource DestructiveBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DestructiveWashBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CheckFeedButton"
                    Content="Check Feed"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Width="98"
                    Height="34"
                    Padding="8,0"
                    Margin="0,0,6,0"
                    Background="{DynamicResource SuccessWashBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}"
                    Foreground="{DynamicResource SuccessBrush}"
                    AutomationProperties.Name="Check feed"
                    ToolTip="Check feed health"
                    Visibility="Collapsed"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CheckFeedButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SuccessHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SuccessPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="ClosePreviewButton"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    IsCancel="True"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="Close feed preview"
                    ToolTip="Close preview"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{DynamicResource SidebarBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DestructiveWashBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource DestructiveBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DestructiveWashBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,4,0,14">
            <TextBlock x:Name="FeedNameText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="FeedCategoryText" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock x:Name="FeedDescriptionText" Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ProgressBar x:Name="LoadingProgressBar"
                     Grid.Row="2"
                     Height="3"
                     Margin="0,0,0,8"
                     IsIndeterminate="True" />
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PreviewItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,11">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PublishedAt, StringFormat={}{0:MMM d, yyyy}}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyStateText"
                       Text="No recent articles are available in this feed."
                       Margin="0,12,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Visibility="Collapsed" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer MaxHeight="160"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ErrorMessageText"
                           Foreground="{DynamicResource DestructiveBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Click="CopyErrorMessage_Click" />
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </ScrollViewer>
            <Button x:Name="ShowRawXmlButton"
                    Grid.Column="1"
                    Content="View XML"
                    MinWidth="88"
                    Padding="10,7"
                    Margin="12,0,0,0"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    AutomationProperties.Name="View feed XML"
                    ToolTip="Open the raw XML returned by the feed"
                    Visibility="Collapsed"
                    Click="ShowRawXmlButton_Click" />
        </Grid>
    </Grid>
    </Border>
</Window>