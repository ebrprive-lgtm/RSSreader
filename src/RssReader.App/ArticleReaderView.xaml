<UserControl x:Class="RssReader.App.ArticleReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RssReader.App">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowSharedResources.xaml" />
                <ResourceDictionary Source="Resources/ArticlePresentationResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:OptionalUriConverter x:Key="OptionalUriConverter" />
            <Geometry x:Key="BackTrailIconGeometry">M 8,3 L 4,7 L 8,11 M 4,7 L 10,7 M 12,3 L 17,3 M 12,7 L 17,7 M 12,11 L 17,11</Geometry>
        </ResourceDictionary>
    </UserControl.Resources>
        <Grid Background="{DynamicResource ContentBrush}"
              Visibility="{Binding IsReadingViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Foreground="{DynamicResource AccentBrush}"
                        Style="{StaticResource IconActionButtonStyle}"
                        ToolTip="Back to previous view (Esc)"
                        AutomationProperties.Name="Go back to previous view"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Path Width="18"
                          Height="18"
                          Data="{StaticResource BackTrailIconGeometry}"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          IsHitTestVisible="False" />
                </Button>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectedArticleWebsiteLink"
                               Grid.Column="0"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding SelectedArticle.IsWebsiteLinkVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                               ToolTip="Open publisher website"
                               AutomationProperties.Name="Open publisher website">
                        <Hyperlink NavigateUri="{Binding SelectedArticle.WebsiteUrl, Mode=OneWay, Converter={StaticResource OptionalUriConverter}}"
                                   RequestNavigate="SourceLink_RequestNavigate"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextDecorations="{x:Null}"
                                   Cursor="Hand">
                            <Run Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="SelectedArticleTitle"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="Open article source">
                        <Hyperlink NavigateUri="{Binding SelectedArticle.Link, Mode=OneWay, Converter={StaticResource OptionalUriConverter}}"
                                   RequestNavigate="SourceLink_RequestNavigate"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextDecorations="{x:Null}"
                                   Cursor="Hand">
                            <Run Text="{Binding SelectedArticle.Title, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="SelectedArticleFeedName"
                           Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Visibility="{Binding HasSelectedArticleFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="Feed: " Foreground="{DynamicResource MutedTextBrush}" />
                    <Hyperlink Command="{Binding NavigateToSelectedArticleFeedCommand}"
                               Foreground="{DynamicResource AccentBrush}"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               ToolTip="Show articles from this feed"
                               AutomationProperties.Name="{Binding SelectedArticle.Source, StringFormat='Open feed {0}'}">
                        <Run Text="{Binding SelectedArticle.Source, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="SelectedArticleAuthor"
                           Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding SelectedArticle.HasAuthor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="By: " FontWeight="SemiBold" />
                    <Run Text="{Binding SelectedArticle.Author, Mode=OneWay}" />
                    <Run Text=" (" />
                    <Run Text="{Binding SelectedArticle.PublishedDateLabel, Mode=OneWay}" />
                    <Run Text=")" />
                </TextBlock>
                <ItemsControl x:Name="SelectedArticleTopicPills"
                              Grid.Row="3"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Margin="0,4,0,0"
                              ItemsSource="{Binding SelectedArticle.TopicChips}"
                              ItemTemplate="{StaticResource ArticleTopicPillTemplate}"
                              ToolTip="{Binding SelectedArticle.FullTopicSummary}"
                              AutomationProperties.Name="Article topics"
                              Visibility="{Binding SelectedArticle.HasTopics, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl x:Name="SelectedArticleFeedTagPills"
                              Grid.Row="4"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Margin="0,3,0,0"
                              ItemsSource="{Binding SelectedArticle.FeedTagChips}"
                              ItemTemplate="{StaticResource ArticleFeedTagPillTemplate}"
                              ToolTip="{Binding SelectedArticle.FullFeedTagSummary}"
                              AutomationProperties.Name="User tags"
                              Visibility="{Binding SelectedArticle.HasFeedTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="SelectedArticleRefreshStatus"
                           Grid.Row="6"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding SelectedArticleRefreshStatusMessage, Mode=OneWay}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Selected feed refresh history"
                           Visibility="{Binding HasSelectedArticleRefreshState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button x:Name="ToggleReadButton"
                            Margin="0,0,4,0"
                            Padding="8,4"
                            Command="{Binding ToggleReadCommand}"
                            ToolTip="Toggle read status (Ctrl+Shift+R)"
                            AutomationProperties.Name="Toggle article read status">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                <Setter Property="Content" Value="Mark read" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedArticle.IsRead}" Value="True">
                                        <Setter Property="Content" Value="Mark unread" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ToggleSavedButton"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Command="{Binding ToggleSavedCommand}"
                            ToolTip="Toggle saved status (Ctrl+Shift+S)"
                            AutomationProperties.Name="Toggle article saved status">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
                                <Setter Property="Content" Value="Save" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedArticle.IsSaved}" Value="True">
                                        <Setter Property="Content" Value="Unsave" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ReaderTypographyButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="0,0,4,0"
                            Style="{StaticResource IconActionButtonStyle}"
                            Click="ReaderTypographyButton_Click"
                            ToolTip="Adjust reader typography"
                            AutomationProperties.Name="Adjust reader typography">
                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                        <Button x:Name="ReaderSplitPaneToggleButton"
                                Margin="0,0,4,0"
                                Style="{StaticResource SplitPaneToggleButtonStyle}"
                                Command="{Binding ToggleSplitPaneCommand}"
                                Visibility="{Binding IsFullPageReadingViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Toggle split view">
                            <Path Width="18"
                                  Height="16"
                                  Data="{StaticResource SplitPaneIconGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  IsHitTestVisible="False" />
                        </Button>
                        <Button x:Name="SelectedArticleActionsButton"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="0,0,6,0"
                                Style="{StaticResource IconActionButtonStyle}"
                                DataContext="{Binding SelectedArticle}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                ContextMenu="{StaticResource ArticleActionsContextMenu}"
                                Click="OpenSelectedArticleActions_Click"
                                ToolTip="More article actions"
                                AutomationProperties.Name="More article actions">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" />
                        </Button>
                        <Button x:Name="PreviousArticleButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="0,0,4,0"
                            Style="{StaticResource IconActionButtonStyle}"
                            Command="{Binding PreviousArticleCommand}"
                            ToolTip="Previous article (Alt+Left)"
                            AutomationProperties.Name="Previous article">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                        <Button x:Name="NextArticleButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Style="{StaticResource IconActionButtonStyle}"
                            Command="{Binding NextArticleCommand}"
                            ToolTip="Next article (Alt+Right)"
                            AutomationProperties.Name="Next article">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="3"
                        Content="Show XML"
                        Click="ShowRawFeed_Click"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="18,0,0,0"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsRawFeedButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
            <local:ArticleHtmlViewer x:Name="SelectedArticleHtmlViewer"
                                     Grid.Row="1"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
        <Popup x:Name="ReaderTypographyPopup"
               Grid.RowSpan="2"
               PlacementTarget="{Binding ElementName=ReaderTypographyButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Width="238"
                    Padding="14"
                    Background="{DynamicResource ContentBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Border.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    </Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource ContentBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                    </Style>
                </Border.Resources>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Reader typography"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Font size" FontSize="11" FontWeight="SemiBold" Margin="0,5,0,4" />
                    <ComboBox x:Name="ReaderTextSizeComboBox"
                              AutomationProperties.Name="Reader font size"
                              SelectionChanged="ReaderTypographyComboBox_SelectionChanged"
                              Padding="6">
                        <ComboBoxItem Content="Small" Tag="0" />
                        <ComboBoxItem Content="Medium" Tag="1" />
                        <ComboBoxItem Content="Large" Tag="2" />
                    </ComboBox>
                    <TextBlock Text="Font type" FontSize="11" FontWeight="SemiBold" Margin="0,9,0,4" />
                    <ComboBox x:Name="ReaderFontFamilyComboBox"
                              AutomationProperties.Name="Reader font type"
                              SelectionChanged="ReaderTypographyComboBox_SelectionChanged"
                              Padding="6">
                        <ComboBoxItem Content="Sans serif" Tag="0" />
                        <ComboBoxItem Content="Serif" Tag="1" />
                        <ComboBoxItem Content="Monospace" Tag="2" />
                    </ComboBox>
                    <TextBlock Text="Line spacing" FontSize="11" FontWeight="SemiBold" Margin="0,9,0,4" />
                    <ComboBox x:Name="ReaderLineSpacingComboBox"
                              AutomationProperties.Name="Reader line spacing"
                              SelectionChanged="ReaderTypographyComboBox_SelectionChanged"
                              Padding="6">
                        <ComboBoxItem Content="Compact" Tag="0" />
                        <ComboBoxItem Content="Normal" Tag="1" />
                        <ComboBoxItem Content="Relaxed" Tag="2" />
                    </ComboBox>
                </StackPanel>
            </Border>
        </Popup>
        </Grid>
</UserControl>
