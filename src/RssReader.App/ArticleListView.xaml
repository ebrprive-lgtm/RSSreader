<UserControl x:Class="RssReader.App.ArticleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RssReader.App">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowSharedResources.xaml" />
                <ResourceDictionary Source="Resources/MainWindowArticleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        <Grid Visibility="{Binding IsArticleListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  MaxWidth="560"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,12"
                  Visibility="{Binding IsSearchRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SearchViewLabel"
                           Text="Search"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           AutomationProperties.Name="Search label" />
                <Grid Grid.Column="1" Width="400" Height="38">
                    <TextBox x:Name="SearchViewSearchBox"
                             Padding="11,8,36,8"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search articles"
                             ToolTip="Search your saved feed articles"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <Button x:Name="ClearSearchViewButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Content="&#xE711;"
                            Style="{StaticResource SearchClearButtonStyle}"
                            Command="{Binding ClearSearchQueryCommand}"
                            Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Clear search"
                            AutomationProperties.Name="Clear search expression" />
                </Grid>
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Topic"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="13" />
                    <ComboBox x:Name="ArticleTopicFilterComboBox"
                              Width="210"
                              Height="34"
                              AutomationProperties.Name="Filter articles by topic"
                              ItemsSource="{Binding ArticleTopicOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedArticleTopic, Mode=TwoWay}" />
                    <Button Content="Clear topic"
                            Margin="6,0,0,0"
                            Padding="8,5"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding ClearArticleTopicCommand}"
                            Visibility="{Binding IsArticleTopicFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton Content="&#xE8D4;"
                                  FontFamily="Segoe MDL2 Assets"
                                  IsChecked="{Binding UnreadOnly, Mode=TwoWay}"
                                  Style="{StaticResource ArticleFilterToggleStyle}"
                                  ToolTip="Show unread articles only"
                                  AutomationProperties.Name="Unread only"
                                  Margin="0,0,6,0" />
                    <ToggleButton Content="&#xE734;"
                                  FontFamily="Segoe MDL2 Assets"
                                  IsChecked="{Binding SavedOnly, Mode=TwoWay}"
                                  Style="{StaticResource ArticleFilterToggleStyle}"
                                  ToolTip="Show saved articles only"
                                  AutomationProperties.Name="Saved only"
                                  Margin="0,0,10,0" />
                    <Border BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Cards"
                                         GroupName="ArticleViewMode"
                                         IsChecked="{Binding IsCardsView, Mode=TwoWay}"
                                         Style="{StaticResource ArticleViewModeStyle}" />
                            <RadioButton Content="Title-Only"
                                         GroupName="ArticleViewMode"
                                         IsChecked="{Binding IsListView, Mode=TwoWay}"
                                         Style="{StaticResource ArticleViewModeStyle}" />
                            <RadioButton Content="Magazine"
                                         GroupName="ArticleViewMode"
                                         IsChecked="{Binding IsMagazineView, Mode=TwoWay}"
                                         Style="{StaticResource ArticleViewModeStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0"
                            BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="2"
                            Visibility="{Binding IsArticleListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Sort by date"
                                         GroupName="ArticleSortMode"
                                         IsChecked="{Binding IsSortByDate, Mode=TwoWay}"
                                         Style="{StaticResource ArticleViewModeStyle}" />
                            <RadioButton Content="Sort by Folder"
                                         GroupName="ArticleSortMode"
                                         IsChecked="{Binding IsSortByFolder, Mode=TwoWay}"
                                         Style="{StaticResource ArticleViewModeStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="ArticleRowsList"
                     Grid.Row="2"
                     Style="{StaticResource VirtualizedArticleListStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ItemsSource="{Binding ArticleListView}"
                     ItemTemplate="{StaticResource ArticleRowTemplate}"
                     Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
            </ListBox>
            <ListBox x:Name="ArticleMagazineList"
                     Grid.Row="2"
                     Style="{StaticResource VirtualizedArticleListStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ItemsSource="{Binding ArticleListView}"
                     ItemTemplate="{StaticResource ArticleMagazineTemplate}"
                     Visibility="{Binding IsMagazineView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
            </ListBox>
            <ListBox x:Name="ArticleCardsList"
                     Grid.Row="2"
                     Style="{StaticResource DateArticleCardsListStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemsSource="{Binding DateSortedArticleListView}"
                     ItemTemplate="{StaticResource ArticleCardTemplate}">
            </ListBox>
            <ListBox x:Name="ArticleFolderCardsList"
                     Grid.Row="2"
                     Style="{StaticResource FolderArticleCardsListStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemsSource="{Binding FolderSortedArticleListView}"
                     ItemTemplate="{StaticResource ArticleCardTemplate}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,14,0,7">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
            </ListBox>
            <StackPanel Grid.Row="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsArticleListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ArticleListEmptyMessage, Mode=OneWay}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
</UserControl>
