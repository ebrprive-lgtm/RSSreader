<UserControl x:Class="RssReader.App.CatalogAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RssReader.App.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MainWindowSharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D9EAF8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#202927" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D9EAF8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#202927" />
            <Style x:Key="CatalogFeedRowCommandPanelStyle"
                   TargetType="StackPanel"
                   BasedOn="{StaticResource RowCommandPanelStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                 Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}"
                                 Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                 Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TaxonomyTreeActionStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource RowCommandNeutralButtonStyle}">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style x:Key="TaxonomyTreeDestructiveActionStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource RowCommandDestructiveButtonStyle}">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style x:Key="TaxonomyTreeNodeNameStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Feed.IsEnabled}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsCategoryFeed}" Value="True" />
                            <Condition Binding="{Binding Feed.IsEnabledInCategory}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsManagedCategory}" Value="True" />
                            <Condition Binding="{Binding Category.IsEnabled}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CatalogFeedNameStyle" TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
                <Grid Visibility="{Binding IsCatalogAdminVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                            <Button x:Name="CatalogActionsButton"
                                    DockPanel.Dock="Right"
                                    Content="..."
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    MinWidth="38"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    ToolTip="Catalog actions"
                                    AutomationProperties.Name="Catalog actions"
                                    Click="CatalogActionsButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Import OPML..." Click="ImportOpml_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8B5;" Style="{StaticResource PositiveContextMenuIconStyle}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Load starter pack"
                                                  Command="{Binding PlacementTarget.DataContext.CatalogManagement.LoadStarterPackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE710;" Style="{StaticResource PositiveContextMenuIconStyle}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button DockPanel.Dock="Right"
                                    Content="Add feed"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    Click="AddFeed_Click" />
                            <Button DockPanel.Dock="Right"
                                    Content="Check All"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Margin="0,0,8,0"
                                    Padding="10,6"
                                    ToolTip="Check all visible feed sources and disable unhealthy or nearly empty feeds"
                                    AutomationProperties.Name="Check All"
                                    Click="CheckAllFeeds_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Catalog Master" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Shared feed catalog" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                <ProgressBar x:Name="CatalogManagementLoadProgressBar"
                                             Height="2"
                                             Margin="0,6,0,0"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsCatalogLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,6"
                                       Visibility="{Binding HasCatalogLoadError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button DockPanel.Dock="Right"
                                        Content="Retry"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding RetryCatalogLoadCommand}"
                                        Padding="9,5" />
                                <TextBlock Text="{Binding CatalogLoadErrorMessage}"
                                           Foreground="{DynamicResource DestructiveBrush}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                            <ScrollViewer MaxHeight="160"
                                          Margin="0,0,0,6"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="CatalogFeedCheckErrorText"
                                           Text="{Binding CatalogManagement.ErrorMessage}"
                                           Foreground="{DynamicResource DestructiveBrush}"
                                           TextWrapping="Wrap">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Copy" Click="CopyCatalogFeedCheckError_Click">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource ContextMenuIconStyle}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </ScrollViewer>
                            <Grid x:Name="CatalogImportReport"
                                  Margin="0,0,0,6"
                                  Visibility="{Binding CatalogManagement.HasImportMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer Grid.Column="0"
                                              MaxHeight="112"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="CatalogImportReportText"
                                               Text="{Binding CatalogManagement.ImportMessage}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                                <Button x:Name="DismissCatalogImportReportButton"
                                        Grid.Column="1"
                                        Content="×"
                                        Width="28"
                                        Height="28"
                                        MinWidth="0"
                                        Padding="0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Top"
                                        ToolTip="Dismiss import report"
                                        AutomationProperties.Name="Dismiss import report"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding CatalogManagement.DismissImportMessageCommand}" />
                            </Grid>
                        </StackPanel>
                        <TabControl x:Name="CatalogManagementTabs" Grid.Row="2" DataContext="{Binding}">
                            <TabItem Header="Feeds" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="CatalogManagementSearchBox"
                                             Grid.Row="0"
                                             MinHeight="34"
                                             Padding="9,5"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Search catalog feeds"
                                             ToolTip="Search feed names, descriptions, categories, feed URLs, and publisher websites"
                                             Text="{Binding CatalogManagement.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                    <WrapPanel Grid.Row="1" Margin="0,8,0,6" VerticalAlignment="Center">
                                        <ComboBox x:Name="CatalogManagementCategoryFilter"
                                                  Width="190"
                                                  Height="32"
                                                  Margin="0,0,8,4"
                                                  AutomationProperties.Name="Filter catalog feeds by category"
                                                  ItemsSource="{Binding CatalogManagement.CategoryFilterOptions}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding CatalogManagement.SelectedCategoryFilter}" />
                                        <ComboBox x:Name="CatalogManagementCollectionFilter"
                                                  Width="190"
                                                  Height="32"
                                                  Margin="0,0,8,4"
                                                  AutomationProperties.Name="Filter catalog feeds by collection"
                                                  ItemsSource="{Binding CatalogManagement.CollectionFilterOptions}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding CatalogManagement.SelectedCollectionFilter}" />
                                        <ComboBox x:Name="CatalogManagementHealthFilter"
                                                  Width="170"
                                                  Height="32"
                                                  Margin="0,0,8,4"
                                                  AutomationProperties.Name="Filter catalog feeds by health check"
                                                  ItemsSource="{Binding CatalogManagement.HealthFilterOptions}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding CatalogManagement.SelectedHealthFilter}" />
                                        <Button Content="Clear filters"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                                Margin="0,0,0,4"
                                                Padding="9,5"
                                                Command="{Binding CatalogManagement.ClearFiltersCommand}" />
                                    </WrapPanel>
                                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding CatalogManagement.FeedResultsSummary}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </DockPanel>
                                    <ScrollViewer Grid.Row="3"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False">
                                    <Grid
                                          Width="1024"
                                          HorizontalAlignment="Left">
                                        <ListBox x:Name="CatalogManagementFeedList"
                                                 ItemsSource="{Binding DataContext.CatalogManagement.VisibleFeeds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 AutomationProperties.Name="Catalog feed management results"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LastHealthCheckSucceeded}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource DestructiveWashBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.Tag>
                                                            <Binding Path="DataContext.CatalogManagement"
                                                                     RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </Border.Tag>
                                                        <Border.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="Preview feed" Click="PreviewManagedFeed_Click">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE890;" Style="{StaticResource ContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Edit feed" Click="EditFeed_Click">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE70F;" Style="{StaticResource ContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Choose collections..." Click="ManageFeedCollections_Click">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE8D4;" Style="{StaticResource ContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator />
                                                                <MenuItem Header="Check feed"
                                                                          Command="{Binding PlacementTarget.Tag.CheckFeedHealthCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE72C;" Style="{StaticResource PositiveContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="{Binding GlobalAvailabilityActionLabel}"
                                                                          Command="{Binding PlacementTarget.Tag.SetGlobalFeedAvailabilityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock"
                                                                                       BasedOn="{StaticResource ContextMenuIconStyle}">
                                                                                    <Setter Property="Text" Value="&#xE8D7;" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Remove feed"
                                                                          Command="{Binding PlacementTarget.Tag.DeleteFeedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource DestructiveContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock DockPanel.Dock="Right"
                                                                               Text="{Binding CategoryName, TargetNullValue=Uncategorized}"
                                                                               Margin="8,0,0,0"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding SameNameDisplay}"
                                                                                   Margin="0,0,8,0"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource WarningBrush}"
                                                                                   Visibility="{Binding HasSameName, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="14"
                                                                                   ToolTip="{Binding HealthCheckDisplay}"
                                                                                   AutomationProperties.Name="{Binding HealthCheckDisplay}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasHealthCheck}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding LastHealthCheckSucceeded}" Value="False">
                                                                                            <Setter Property="Text" Value="&#xE711;" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="14"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Name}"
                                                                               Style="{StaticResource CatalogFeedNameStyle}" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="0,1,8,0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Description}"
                                                                           AutomationProperties.Name="Catalog feed description"
                                                                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <StackPanel Margin="0,1,8,0">
                                                                    <TextBlock FontSize="10"
                                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding FeedUrl}">
                                                                        <Run Text="Feed: " />
                                                                        <Hyperlink NavigateUri="{Binding FeedUrl, Mode=OneWay, Converter={StaticResource OptionalUriConverter}}"
                                                                                   RequestNavigate="SourceLink_RequestNavigate"
                                                                                   Style="{StaticResource FeedSourceLinkStyle}">
                                                                            <Run Text="{Binding FeedUrl, Mode=OneWay}" />
                                                                        </Hyperlink>
                                                                    </TextBlock>
                                                                    <TextBlock FontSize="10"
                                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding WebsiteUrl}"
                                                                               Visibility="{Binding HasWebsiteUrl, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <Run Text="Publisher website: " />
                                                                        <Hyperlink NavigateUri="{Binding WebsiteUrl, Mode=OneWay, Converter={StaticResource OptionalUriConverter}}"
                                                                                   RequestNavigate="SourceLink_RequestNavigate"
                                                                                   Style="{StaticResource FeedSourceLinkStyle}">
                                                                            <Run Text="{Binding WebsiteUrl, Mode=OneWay}" />
                                                                        </Hyperlink>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,28,0"
                                                                        Style="{StaticResource CatalogFeedRowCommandPanelStyle}">
                                                                <Button Click="PreviewManagedFeed_Click"
                                                                        Width="28"
                                                                        Height="28"
                                                                        Style="{StaticResource RowCommandNeutralButtonStyle}"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Preview feed"
                                                                        AutomationProperties.Name="Preview feed">
                                                                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{StaticResource RowCommandNeutralIconStyle}" />
                                                                </Button>
                                                                <Button Click="EditFeed_Click"
                                                                        Width="28"
                                                                        Height="28"
                                                                    Style="{StaticResource RowCommandNeutralButtonStyle}"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Edit feed"
                                                                        AutomationProperties.Name="Edit feed">
                                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{StaticResource RowCommandNeutralIconStyle}" />
                                                                </Button>
                                                                <Button Click="ManageFeedCollections_Click"
                                                                        Width="28"
                                                                        Height="28"
                                                                        Margin="2,0"
                                                                        Padding="0"
                                                                        Style="{StaticResource RowCommandNeutralButtonStyle}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Choose which collections include this feed"
                                                                        AutomationProperties.Name="Choose collections for feed">
                                                                    <TextBlock Text="&#xE8D4;" Style="{StaticResource RowCommandNeutralIconStyle}" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                                                </Button>
                                                                <Button Command="{Binding DataContext.CatalogManagement.CheckFeedHealthCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                Width="28"
                                                                Height="28"
                                                                    Style="{StaticResource RowCommandPositiveButtonStyle}"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Check feed"
                                                                        AutomationProperties.Name="Check feed">
                                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{StaticResource RowCommandPositiveIconStyle}" />
                                                                </Button>
                                                                <Button Command="{Binding DataContext.CatalogManagement.DeleteFeedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                Width="28"
                                                                Height="28"
                                                                    Style="{StaticResource RowCommandDestructiveButtonStyle}"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        ToolTip="Remove feed"
                                                                        AutomationProperties.Name="Remove feed">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{StaticResource RowCommandDestructiveIconStyle}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{Binding CatalogManagement.FeedResultsEmptyMessage}"
                                                   Margin="12,16,12,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   IsHitTestVisible="False"
                                                   Panel.ZIndex="1"
                                                   Visibility="{Binding CatalogManagement.IsFeedResultsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Categories &amp; collections" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid Margin="12" x:Name="CatalogTaxonomyViewport">
                                    <Grid x:Name="CatalogTaxonomyLayout"
                                          Width="{Binding ActualWidth, ElementName=CatalogTaxonomyViewport}"
                                          MaxWidth="1280"
                                          HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Margin="0,0,16,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="+"
                                                    Width="30"
                                                    Height="30"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    FontSize="19"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource SuccessBrush}"
                                                    Padding="0"
                                                    ToolTip="Add category"
                                                    AutomationProperties.Name="Add category"
                                                    Click="AddCategory_Click" />
                                            <TextBlock Text="Categories" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TreeView Grid.Row="1"
                                                  ItemsSource="{Binding CatalogManagement.CategoryTreeNodes}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalContentAlignment="Stretch"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <TreeView.Resources>
                                                <HierarchicalDataTemplate DataType="{x:Type vm:CatalogTaxonomyTreeNode}"
                                                                          ItemsSource="{Binding Children}">
                                                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"
                                                          Height="40">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Margin" Value="-20,0,0,0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFeedNode}" Value="True">
                                                                        <Setter Property="Margin" Value="-39,0,0,0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Border Background="Transparent"
                                                                BorderBrush="{DynamicResource SeparatorBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                IsHitTestVisible="False" />
                                                        <Border BorderBrush="{DynamicResource SeparatorBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Height="40"
                                                                HorizontalAlignment="Stretch"
                                                                Padding="6,4"
                                                                ContextMenuOpening="TaxonomyItem_ContextMenuOpening">
