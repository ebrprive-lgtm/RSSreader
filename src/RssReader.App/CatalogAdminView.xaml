                                                                          Visibility="{Binding IsManagedCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE70F;" Style="{StaticResource ContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Remove category"
                                                                          Command="{Binding Management.DeleteCategoryCommand}"
                                                                          CommandParameter="{Binding Category}"
                                                                          Visibility="{Binding IsManagedCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource DestructiveContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Add category"
                                                                          Click="AddCategoryToCollection_Click"
                                                                          Visibility="{Binding IsCollection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE710;" Style="{StaticResource PositiveContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Manage feeds"
                                                                          Click="ManageCollectionFeeds_Click"
                                                                          Visibility="{Binding IsCollection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE8FD;" Style="{StaticResource ContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Rename collection"
                                                                          Click="RenameCollection_Click"
                                                                          Visibility="{Binding IsCollection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE70F;" Style="{StaticResource ContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Remove collection"
                                                                          Command="{Binding Management.DeleteCollectionCommand}"
                                                                          CommandParameter="{Binding Collection}"
                                                                          Visibility="{Binding IsCollection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource DestructiveContextMenuIconStyle}" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource TaxonomyTreeNodeNameStyle}" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel" BasedOn="{StaticResource RowCommandPanelStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsManagedCategory}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Click="RenameCategory_Click"
                                                                        ToolTip="Rename category"
                                                                        AutomationProperties.Name="Rename category">
                                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandNeutralIconStyle}" />
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Command="{Binding Management.SetCategoryAvailabilityCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="{Binding CategoryAvailabilityActionLabel}"
                                                                        AutomationProperties.Name="{Binding CategoryAvailabilityActionLabel}">
                                                                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="15">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource RowCommandPositiveIconStyle}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Category.IsEnabled}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Click="CheckCategoryFeeds_Click"
                                                                        ToolTip="Check feeds"
                                                                        AutomationProperties.Name="Check feeds">
                                                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandPositiveIconStyle}" />
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0"
                                                                        Style="{StaticResource TaxonomyTreeDestructiveActionStyle}"
                                                                        Command="{Binding Management.DeleteCategoryCommand}"
                                                                        CommandParameter="{Binding Category}"
                                                                        ToolTip="Remove category"
                                                                        AutomationProperties.Name="Remove category">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandDestructiveIconStyle}" />
                                                                </Button>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel" BasedOn="{StaticResource RowCommandPanelStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollection}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Click="AddCategoryToCollection_Click"
                                                                        ToolTip="Add all feeds from a category"
                                                                        AutomationProperties.Name="Add category to collection">
                                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandPositiveIconStyle}" />
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Click="ManageCollectionFeeds_Click"
                                                                        ToolTip="Add or remove feeds"
                                                                        AutomationProperties.Name="Manage feeds in collection">
                                                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandNeutralIconStyle}" />
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Click="RenameCollection_Click"
                                                                        ToolTip="Rename collection"
                                                                        AutomationProperties.Name="Rename collection">
                                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandNeutralIconStyle}" />
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0"
                                                                        Style="{StaticResource TaxonomyTreeDestructiveActionStyle}"
                                                                        Command="{Binding Management.DeleteCollectionCommand}"
                                                                        CommandParameter="{Binding Collection}"
                                                                        ToolTip="Remove collection"
                                                                        AutomationProperties.Name="Remove collection">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandDestructiveIconStyle}" />
                                                                </Button>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel" BasedOn="{StaticResource RowCommandPanelStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFeedNode}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Click="PreviewManagedFeed_Click"
                                                                        ToolTip="Preview feed"
                                                                        AutomationProperties.Name="Preview feed">
                                                                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandNeutralIconStyle}" />
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Command="{Binding Management.SetCategoryFeedAvailabilityCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="{Binding AvailabilityActionLabel}"
                                                                        AutomationProperties.Name="{Binding AvailabilityActionLabel}"
                                                                        Visibility="{Binding IsCategoryFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock"
                                                                                   BasedOn="{StaticResource RowCommandPositiveIconStyle}">
                                                                                <Setter Property="Text" Value="&#xE8D7;" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Feed.IsEnabledInCategory}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeActionStyle}"
                                                                        Command="{Binding Management.SetGlobalFeedAvailabilityCommand}"
                                                                        CommandParameter="{Binding Feed}"
                                                                        ToolTip="{Binding AvailabilityActionLabel}"
                                                                        AutomationProperties.Name="{Binding AvailabilityActionLabel}"
                                                                        Visibility="{Binding IsCollectionFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock"
                                                                                   BasedOn="{StaticResource RowCommandPositiveIconStyle}">
                                                                                <Setter Property="Text" Value="&#xE8D7;" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Feed.IsEnabled}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Feed.IsEnabled}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0" Margin="0,0,2,0"
                                                                        Style="{StaticResource TaxonomyTreeDestructiveActionStyle}"
                                                                        Command="{Binding Management.DeleteFeedCommand}"
                                                                        CommandParameter="{Binding Feed}"
                                                                        ToolTip="Remove permanently"
                                                                        AutomationProperties.Name="Remove feed permanently"
                                                                        Visibility="{Binding IsCategoryFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandDestructiveIconStyle}" />
                                                                </Button>
                                                                <Button Width="30" Height="30" Padding="0"
                                                                        Style="{StaticResource TaxonomyTreeDestructiveActionStyle}"
                                                                        Command="{Binding Management.RemoveCollectionTreeFeedCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Remove from collection"
                                                                        AutomationProperties.Name="Remove from collection"
                                                                        Visibility="{Binding IsCollectionFeed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Style="{StaticResource RowCommandDestructiveIconStyle}" />
                                                                </Button>
                                                            </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </HierarchicalDataTemplate>
                                            </TreeView.Resources>
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                    <EventSetter Event="Expanded" Handler="CatalogTreeItem_Expanded" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                        </TreeView>
                                    </Grid>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
</UserControl>
