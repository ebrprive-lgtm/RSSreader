<Window x:Class="RssReader.App.RawFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RssReader.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        Width="980"
        Height="700"
        Topmost="True"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ContentBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
        <Border Margin="8"
            Background="{DynamicResource ContentBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid Margin="0,0,42,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Raw feed XML" FontSize="18" FontWeight="SemiBold" />
                    <Border x:Name="CachedSourceBadge"
                            Margin="10,0,0,0"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource WindowBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <TextBlock Text="CACHED"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="FeedSourceText"
                           Grid.Row="1"
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button Content="&#xE711;"
                    Style="{StaticResource IconActionButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ToolTip="Close dialog"
                    AutomationProperties.Name="Close dialog"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseWindow_Click" />
        </Grid>
        <TreeView x:Name="RawContentTreeView"
                  Grid.Row="1"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Padding="12"
                  Background="{DynamicResource WindowBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:RawXmlTreeNode}"
                                          ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayText}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12">
                        <TextBlock.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Copy" Click="CopyTreeNode_Click" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEncoded}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="CopyStatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyXmlButton"
                        Content="Copy XML"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        AutomationProperties.Name="Copy XML"
                        MinWidth="100"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Click="CopyXml_Click" />
            <Button Content="Close" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" MinWidth="84" Padding="12,7" Click="CloseWindow_Click" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>