<Window x:Class="RssReader.App.RawFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        Width="980"
        Height="700"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
        <Border Margin="8"
            Background="{StaticResource ContentBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <StackPanel Margin="0,0,42,0">
                <TextBlock Text="Raw feed XML" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="FeedSourceText"
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Content="&#xE711;"
                    Style="{StaticResource IconActionButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ToolTip="Close dialog"
                    AutomationProperties.Name="Close dialog"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseWindow_Click" />
        </Grid>
        <TextBox x:Name="RawContentTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Padding="12"
                 Background="#FAFBFA"
                 BorderBrush="{StaticResource ControlBorderBrush}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" MinWidth="84" Padding="12,7" />
        </StackPanel>
    </Grid>
    </Border>
</Window>