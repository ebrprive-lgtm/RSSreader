<Window x:Class="RssReader.App.RawFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RssReader.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        Width="980"
        Height="700"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
        <Border Margin="8"
            Background="{StaticResource ContentBrush}"
            BorderBrush="{StaticResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <StackPanel Margin="0,0,42,0">
                <TextBlock Text="Raw feed XML" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="FeedSourceText"
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Content="&#xE711;"
                    Style="{StaticResource IconActionButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ToolTip="Close dialog"
                    AutomationProperties.Name="Close dialog"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseWindow_Click" />
        </Grid>
        <TreeView x:Name="RawContentTreeView"
                  Grid.Row="1"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Padding="12"
                  Background="#FAFBFA"
                  BorderBrush="{StaticResource ControlBorderBrush}">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:RawXmlTreeNode}"
                                          ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayText}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12" />
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="CopyStatusText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyXmlButton"
                        Content="Copy XML"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        AutomationProperties.Name="Copy XML"
                        MinWidth="100"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Click="CopyXml_Click" />
            <Button Content="Close" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" MinWidth="84" Padding="12,7" />
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>