<Window x:Class="RssReader.App.RawFeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raw feed XML"
        Width="980"
        Height="700"
        MinWidth="700"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Raw feed XML" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="FeedSourceText"
                       Margin="0,5,0,0"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBox x:Name="RawContentTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Padding="12"
                 Background="#FAFBFA"
                 BorderBrush="#DDE3E0" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" IsCancel="True" MinWidth="84" Padding="12,7" />
        </StackPanel>
    </Grid>
</Window>